    {%- comment -%} Shopify Inbox chat launcher restyle (new <shopify-chat>
      widget, July 2026 rewrite): pill with green dot and "Kontakta oss" on a
      translucent #786853 blur background. The widget is now
      <shopify-chat> → shadow → <shopify-agent-runtime exportparts="activator,
      dialog"> → shadow → button.activator (part="activator") + section.panel
      (part="dialog"; header holds shopify-sign-in-button, body holds the chat
      iframe). Both shadow roots are open.

      The widget boots in TWO STAGES: a fresh page load renders only a static
      placeholder activator directly in the shopify-chat shadow root (no
      runtime element at all); <shopify-agent-runtime> mounts lazily, e.g. on
      first interaction. Styling must therefore target whichever root holds
      button.activator right now and be re-applied when the runtime mounts —
      waiting for the runtime alone leaves the placeholder unstyled (and, with
      the flash-guard below, permanently invisible).

      Pill geometry/background is styled from document CSS via ::part(activator).
      Label text swap ("Chatt" → "Kontakta oss"), the green dot, restyling the
      sign-in button (black, matching site buttons — visitors use it to leave
      contact details) and the adaptive label color need the shadow root: a
      <style> is injected there and re-checked by MutationObservers since the
      widget re-renders on open/close/upgrade.

      Label color adapts to the backdrop: black on light ground, white on dark,
      via the --mug-chat-ink custom property (inherits into the shadow).
      Backdrop is found with elementsFromPoint under the pill; images are
      region-sampled through cover-mapping (Shopify's CDN sends CORS headers;
      Instant's cdn.instant.so does not → unsampleable large images are treated
      as photography → white text). {%- endcomment -%}
    <style>
      /* Hide the activator until our shadow styling has been applied —
         prevents the flash of Shopify's default icon + "Chatt" pill. */
      shopify-chat:not(.mug-ready)::part(activator) {
        opacity: 0;
        pointer-events: none;
      }
      shopify-chat::part(activator) {
        opacity: 1;
        transition: background-color 150ms ease, opacity 200ms ease;
        background: rgba(120, 104, 83, 0.18);
        -webkit-backdrop-filter: blur(30px);
        backdrop-filter: blur(30px);
        border-radius: 100px;
        box-shadow: none;
        height: 38px;
        min-width: 0;
        padding: 0 16px 0 12px;
        transition: background-color 150ms ease;
      }
      shopify-chat::part(activator):hover {
        background: rgba(120, 104, 83, 0.3);
      }
    </style>
    <script>
      (function () {
        var LABEL = 'Kontakta oss';

        /* ---- adaptive label color ------------------------------------- */
        var imgCache = {};
        function loadImage(src) {
          if (imgCache[src]) return imgCache[src];
          imgCache[src] = new Promise(function (resolve) {
            var img = new Image();
            img.crossOrigin = 'anonymous';
            img.onload = function () { resolve(img); };
            img.onerror = function () { resolve(null); };
            img.src = src;
          });
          return imgCache[src];
        }
        function imageLuminanceAt(src, el, px, py) {
          return loadImage(src).then(function (img) {
            if (!img || !img.naturalWidth) return null;
            try {
              var r = el.getBoundingClientRect();
              var scale = Math.max(r.width / img.naturalWidth, r.height / img.naturalHeight);
              var offX = r.left + (r.width - img.naturalWidth * scale) / 2;
              var offY = r.top + (r.height - img.naturalHeight * scale) / 2;
              var sx = (px - offX) / scale, sy = (py - offY) / scale;
              var half = Math.max(12, 24 / scale);
              var x0 = Math.max(0, Math.min(img.naturalWidth - 1, sx - half));
              var y0 = Math.max(0, Math.min(img.naturalHeight - 1, sy - half));
              var w = Math.min(img.naturalWidth - x0, half * 2) || 1;
              var h = Math.min(img.naturalHeight - y0, half * 2) || 1;
              var cv = document.createElement('canvas');
              cv.width = 8; cv.height = 8;
              var cx = cv.getContext('2d');
              cx.drawImage(img, x0, y0, w, h, 0, 0, 8, 8);
              var d = cx.getImageData(0, 0, 8, 8).data, sum = 0, n = 0;
              for (var i = 0; i < d.length; i += 4) {
                if (d[i + 3] < 8) continue;
                sum += 0.2126 * d[i] + 0.7152 * d[i + 1] + 0.0722 * d[i + 2];
                n++;
              }
              return n ? sum / n : null;
            } catch (e) { return null; }
          });
        }

        /* Whichever shadow root holds the activator right now: the runtime's
           once mounted, otherwise the placeholder stage in the host's root. */
        function currentRoot() {
          var host = document.querySelector('shopify-chat');
          if (!host || !host.shadowRoot) return null;
          var runtime = host.shadowRoot.querySelector('shopify-agent-runtime');
          if (runtime && runtime.shadowRoot && runtime.shadowRoot.querySelector('button.activator')) {
            return runtime.shadowRoot;
          }
          return host.shadowRoot.querySelector('button.activator') ? host.shadowRoot : null;
        }
        function activatorButton() {
          var rs = currentRoot();
          return rs ? rs.querySelector('button.activator') : null;
        }

        var colorPending = false;
        function updateLabelColor() {
          if (colorPending) return;
          colorPending = true;
          requestAnimationFrame(function () {
            colorPending = false;
            var btn = activatorButton();
            var host = document.querySelector('shopify-chat');
            if (!btn || !host) return;
            var r = btn.getBoundingClientRect();
            if (!r.width) return;
            var ptX = r.left + r.width / 2, ptY = r.top + r.height / 2;
            var stack = document.elementsFromPoint(ptX, ptY)
              .filter(function (el) { return el !== host && el.tagName !== 'HTML'; });

            function apply(lum) {
              /* 165: mid-tone backdrops read better with white — black only
                 on clearly light ground. Inherited into the shadow root. */
              host.style.setProperty('--mug-chat-ink', lum > 165 ? 'rgba(0,0,0,0.9)' : 'rgba(255,255,255,0.9)');
            }

            (function walk(idx) {
              if (idx >= stack.length) return apply(255); /* white page default */
              var el = stack[idx];
              var cs = getComputedStyle(el);
              var src = null;
              if (el.tagName === 'IMG') src = el.currentSrc || el.src || null;
              if (!src) {
                var m = (cs.backgroundImage || '').match(/url\("?([^")]+)/);
                if (m) src = m[1];
              }
              if (src) {
                var er = el.getBoundingClientRect();
                var isLargePhoto = er.width * er.height > 40000;
                imageLuminanceAt(src, el, ptX, ptY).then(function (lum) {
                  if (lum != null) apply(lum);
                  else if (isLargePhoto) apply(0); /* unsampleable (no CORS) large image = photo */
                  else walk(idx + 1);
                });
                return;
              }
              var c = (cs.backgroundColor || '').match(/rgba?\(([\d.]+)[, ]+([\d.]+)[, ]+([\d.]+)(?:[,/ ]+([\d.]+))?/);
              if (c && (c[4] === undefined || parseFloat(c[4]) > 0.4)) {
                return apply(0.2126 * c[1] + 0.7152 * c[2] + 0.0722 * c[3]);
              }
              walk(idx + 1);
            })(0);
          });
        }

        /* ---- shadow styling + label swap ------------------------------ */
        function customize(rs) {
          if (!rs.querySelector('#mug-chat-style')) {
            var st = document.createElement('style');
            st.id = 'mug-chat-style';
            st.textContent = [
              /* pill label: green dot + text in the adaptive ink color */
              '.activator__icon { display: none !important; }',
              '.activator__label {',
              '  display: inline-flex; align-items: center; gap: 10px;',
              "  font: 400 13px/1 'Inter Variable', sans-serif !important;",
              '  color: var(--mug-chat-ink, rgba(0,0,0,0.9)) !important;',
              '  white-space: nowrap;',
              '}',
              '@media (max-width: 749px) { .activator__label { font-size: 15px !important; } }',
              /* unread-reply badge: keep the widget's show/hide logic
                 (--active class) but make it bigger and notification-red */
              '.activator__indicator--active {',
              '  background: #e70a0a !important;',
              '  width: 10px !important; height: 10px !important;',
              '  border-radius: 50% !important;',
              '}',
              '.activator__label::before {',
              "  content: ''; width: 10px; height: 10px; border-radius: 50%;",
              '  background: #34C759; display: inline-block; flex-shrink: 0;',
              '}',
            ].join('\n');
            rs.appendChild(st);
          }
          /* sign-in button (own shadow root, no exported parts): restyle the
             default purple pill to match the site's white buttons (like "Lägg
             till i varukorgen") so visitors can log in and leave contact
             details */
          var si = rs.querySelector('shopify-sign-in-button');
          if (si && si.shadowRoot && !si.shadowRoot.querySelector('#mug-signin-style')) {
            var ss = document.createElement('style');
            ss.id = 'mug-signin-style';
            ss.textContent = [
              /* the id selector outranks the widget's own !important rules in
                 its adopted stylesheets (importance ties break on specificity) */
              '#shopify-element-wrapper .sign-in-button {',
              '  background: #fff !important; color: #000 !important;',
              '  border: 0 !important; border-radius: 20px !important;',
              '  box-shadow: inset 0 0 0 1px #dcdcdc !important;',
              "  font: 600 12px/1 'Inter Variable', sans-serif !important;",
              '  padding: 9px 14px !important; cursor: pointer;',
              '  transition: background-color 150ms ease;',
              '}',
              '#shopify-element-wrapper .sign-in-button:hover { background: #f5f5f5 !important; }',
            ].join('\n');
            si.shadowRoot.appendChild(ss);
          }
          var label = rs.querySelector('.activator__label');
          if (label && label.textContent !== LABEL) label.textContent = LABEL;
          var host = document.querySelector('shopify-chat');
          if (host && label) host.classList.add('mug-ready');
          updateLabelColor();
          return true;
        }

        var observedRoots = [];
        function observeRoot(root) {
          if (!root || observedRoots.indexOf(root) !== -1) return;
          observedRoots.push(root);
          new MutationObserver(applyStage).observe(root, { childList: true, subtree: true, characterData: true });
        }
        function applyStage() {
          var host = document.querySelector('shopify-chat');
          if (!host || !host.shadowRoot) return false;
          /* outer root: catches the lazy runtime mount replacing the placeholder */
          observeRoot(host.shadowRoot);
          var runtime = host.shadowRoot.querySelector('shopify-agent-runtime');
          if (runtime) observeRoot(runtime.shadowRoot);
          var rs = currentRoot();
          if (!rs) return false;
          customize(rs);
          return true;
        }

        function init() {
          if (!applyStage()) return false;
          window.addEventListener('scroll', updateLabelColor, { passive: true });
          window.addEventListener('resize', updateLabelColor, { passive: true });
          return true;
        }

        if (!init()) {
          var tries = 0;
          var iv = setInterval(function () {
            if (init() || ++tries > 60) clearInterval(iv);
          }, 500);
        }
      })();
    </script>
  </body>
</html>