{% comment %}
  robots.txt.liquid — Shopify robots template
  Outputs Shopify's defaults then blocks filter/sort parameter URLs
  that create duplicate collection content.
{% endcomment %}

{% for group in robots.default_groups %}
{{ group.user_agent }}
{% for rule in group.rules -%}
{%- comment -%}
  Shopify's default "*/collections/*filter*&*filter*" starts with "*" —
  formally invalid robots syntax (paths must start with "/"), flagged by
  validators. Emit a "/"-prefixed equivalent pair instead.
{%- endcomment -%}
{%- assign rule_value = rule.value -%}
{%- if rule_value == '*/collections/*filter*&*filter*' -%}
{{ rule.directive }}: /collections/*filter*&*filter*
{{ rule.directive }}: /*/collections/*filter*&*filter*
{% else -%}
{{ rule.directive }}: {{ rule_value }}
{% endif -%}
{% endfor %}
{%- if group.user_agent.value == '*' -%}
# Extra: block sort/filter parameter URLs (duplicate content).
# pf_* are legacy Boost-filter params still linked from old content.
# Deliberately NOT blocking ?page= — pagination must stay crawlable.
Disallow: /*?sort_by=
Disallow: /*?filter.
Disallow: /*?pf_*
Disallow: /*&pf_*
# Shopifys interna sökresultatlänkar. De pekar kanoniskt rätt men utgör
# största delen av de 26 405 adresser Google genomsöker om i onödan
# (2026-09-25: 96 % av genomsökningen gick till "Uppdatering", 4 % till
# att hitta nytt). Ingen av dem har eget sökvärde.
# OBS: blockera aldrig ?variant= — mug-product-json-ld.liquid pekar dit
# med Offer.url för flervariantprodukter.
Disallow: /*?*_pos=
Disallow: /*?*_ss=
# Undantag: sections/main-collection.liquid skickar varje kollektion vidare
# till ?filter.v.availability=1 (döljer slutsålda). Googlebot kör JS och
# följer med, så just den adressen (och dess sidnumrering) måste få läsas —
# annars blir kollektionerna "Indexerad men blockerad av robots.txt".
# Sidan pekar kanoniskt på den rena adressen. Längsta regeln vinner hos
# Google, så dessa slår Disallow: /*?filter. ovan. Omdirigeringen togs bort
# 2026-09-18; reglerna ligger kvar några veckor så Google kan läsa om de
# spärrade adresserna och samla dem under den rena adressen. Ta bort därefter.
Allow: /collections/*?filter.v.availability=1$
Allow: /collections/*?filter.v.availability=1&page=
# 2026-09-25: 11 394 exakta 301:or lades från /en<väg> till <väg> (ett
# avpublicerat engelskt språkprefix som gav 18 318 st 404). Undantagen ovan
# matchar bara /collections/, inte /en/collections/, så de gamla adresserna
# låg kvar blockerade och Google kunde aldrig hämta dem för att upptäcka
# omdirigeringen. Längsta regeln vinner, så denna slår Disallow: /*?filter.
# Kan tas bort när Hittades inte (404) har arbetat av sig.
Allow: /en/*?filter.
{% endif %}
{% if group.sitemap -%}
Sitemap: {{ group.sitemap.value }}
{% endif %}

{% endfor %}
