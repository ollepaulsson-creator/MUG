    "mug_05": {
      "type": "mug-artikel",
      "blocks": {
        "b01": {
          "type": "rubrik",
          "settings": {
            "text": "Elektronik och pickuper",
            "niva": "h2"
          }
        },
        "b02": {
          "type": "text",
          "settings": {
            "text": "<p>Glapp, skrapande potentiometrar, trasiga omkopplare, dåliga lödningar och pickupbyten är vanliga problem som vi hjälper till med.</p>",
            "stil": "brod"
          }
        },
        "b03": {
          "type": "rubrik",
          "settings": {
            "text": "Felsökning och elektronikjobb",
            "niva": "h3"
          }
        },
        "b04": {
          "type": "text",
          "settings": {
            "text": "<p>Timdebitering används framför allt vid större arbeten där flera komponenter behöver repareras eller bytas.</p>",
            "stil": "brod"
          }
        },
        "b05": {
