{%- doc -%}
  MUG 2026-11-08 (etapp 4, ersätter Instant-sidornas textavsnitt).
  Två stilar med Instant-sidornas mått:
  - intro: centrerat, logga (238 px), H1 32/1.3 (maxbredd 50 % → 65/85/90 %), ingress 18/1.5 (45 % → 90 %)
  - avsnitt: vänsterställt, 40 px luft över, rubrik 24 px, text 16/1.6 (maxbredd 65 % → 90/100 %)
{%- enddoc -%}
{%- liquid
  assign s = section.settings
  assign niva = s.rubrikniva | default: 'h2'
-%}
<div
  class="mug-text mug-text--{{ s.stil }}"
  style="--mt-bg: {{ s.bakgrund }}; --mt-farg: {{ s.textfarg }}; --mt-luft-under: {{ s.luft_under }}px; --mt-luft-over: {{ s.luft_over | default: 0 }}px; --mt-rubrik-rad: {{ s.rubrik_radavstand | divided_by: 100.0 }};"
>
  {%- if s.logga != blank -%}
    {%- assign loggastil = 'width: ' | append: s.logga_bredd | append: 'px' -%}
    {{- s.logga | image_url: width: 600 | image_tag: loading: 'eager', alt: s.logga_alt, class: 'mug-text__logga', style: loggastil -}}
  {%- endif -%}
  {%- if s.rubrik != blank -%}
    <{{ niva }} class="mug-text__rubrik">{{ s.rubrik | escape }}</{{ niva }}>
  {%- endif -%}
  {%- if s.text != blank -%}
    <div class="mug-text__text">{{ s.text }}</div>
  {%- endif -%}
  {%- if s.knapp_text != blank and s.knapp_lank != blank -%}
    <a class="mug-text__knapp" href="{{ s.knapp_lank }}">{{ s.knapp_text | escape }}</a>
  {%- endif -%}
</div>

{% stylesheet %}
  .mug-text {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--mt-bg);
    color: var(--mt-farg);
    padding-bottom: var(--mt-luft-under);
    padding-top: var(--mt-luft-over, 0px);
  }

  .mug-text__rubrik,
  .mug-text__text,
  .mug-text__text p {
    color: inherit;
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
    margin: 0;
  }

  .mug-text__text p + p {
    margin-top: 1em;
  }

  .mug-text__text a {
    color: inherit;
  }

  .mug-text__knapp {
    display: inline-flex;
    margin-top: 40px;
    padding: 20px 24px;
    background: #000;
    color: #fff;
    font-size: 14px;
    line-height: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .mug-text__knapp:hover {
    background: #333;
  }

  /* intro */
  .mug-text--intro {
    align-items: center;
    text-align: center;
  }

  .mug-text--intro .mug-text__logga {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 80px 0 40px;
  }

  .mug-text--intro .mug-text__rubrik {
    max-width: 50%;
    margin-bottom: 20px;
    font-size: 32px;
    line-height: 1.3;
  }

  .mug-text--intro .mug-text__text {
    max-width: 45%;
    font-size: 18px;
    line-height: 1.5;
  }

  /* avsnitt */
  .mug-text--avsnitt {
    align-items: flex-start;
    padding: 40px 30px var(--mt-luft-under);
  }

  .mug-text--avsnitt .mug-text__logga {
    display: block;
    height: auto;
    margin-bottom: 20px;
  }

  .mug-text--avsnitt .mug-text__rubrik {
    width: 100%;
    margin-bottom: 10px;
    font-size: 24px;
    line-height: var(--mt-rubrik-rad, 1.15);
  }

  .mug-text--avsnitt .mug-text__text {
    max-width: 65%;
    font-size: 16px;
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .mug-text--intro .mug-text__rubrik { max-width: 65%; }
  }

  @media (max-width: 768px) {
    .mug-text--intro .mug-text__rubrik { max-width: 85%; }
    .mug-text--avsnitt .mug-text__text { max-width: 90%; }
  }

  @media (max-width: 575px) {
    .mug-text--intro { padding-top: max(20px, calc(var(--mt-luft-over, 0px) * 0.67)); }
    .mug-text--intro .mug-text__logga { margin: 60px 0 40px; }
    .mug-text--intro .mug-text__rubrik,
    .mug-text--intro .mug-text__text { max-width: 90%; }
    .mug-text--avsnitt .mug-text__text { max-width: 100%; }
  }

  .mug-text__rubrik,
  .mug-text__text {
    text-wrap-style: pretty;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MUG textblock",
  "tag": "section",
  "class": "mug-text-sektion",
  "settings": [
    {
      "type": "select",
      "id": "stil",
      "label": "Stil",
      "options": [
        { "value": "intro", "label": "Intro (centrerad, stor rubrik)" },
        { "value": "avsnitt", "label": "Avsnitt (vänsterställd)" }
      ],
      "default": "avsnitt"
    },
    { "type": "image_picker", "id": "logga", "label": "Logga" },
    { "type": "range", "id": "logga_bredd", "label": "Loggans bredd", "min": 62, "max": 398, "step": 4, "unit": "px", "default": 238 },
    { "type": "text", "id": "logga_alt", "label": "Loggans alt-text" },
    { "type": "text", "id": "rubrik", "label": "Rubrik" },
    {
      "type": "select",
      "id": "rubrikniva",
      "label": "Rubriknivå",
      "options": [
        { "value": "h1", "label": "H1 (sidans huvudrubrik)" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    { "type": "number", "id": "rubrik_radavstand", "label": "Rubrikens radavstånd (%, avsnitt)", "default": 115 },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "knapp_text", "label": "Knapptext" },
    { "type": "url", "id": "knapp_lank", "label": "Knapplänk" },
    { "type": "color", "id": "bakgrund", "label": "Bakgrund", "default": "#ffffff" },
    { "type": "color", "id": "textfarg", "label": "Textfärg", "default": "#000000" },
    { "type": "range", "id": "luft_over", "label": "Luft över", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "luft_under", "label": "Luft under", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "MUG textblock" }]
}
{% endschema %}
