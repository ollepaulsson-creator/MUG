{%- comment -%}
  SEO-brödtext under produktgriden. Renderas ENDAST när kollektionen har
  custom.seo_brodtext (rich text). Rubrik ur custom.seo_rubrik.
  Layout enligt Figma-spec 2026-08-26: separatorlinje, centrerat block
  två gridkolumner brett på desktop, 32px rubrik, 5-raders trunkering med Läs mer.
{%- endcomment -%}
{%- assign mug_seo_text = collection.metafields.custom.seo_brodtext -%}
{%- if mug_seo_text != blank -%}
  <div class="mug-seo-block">
    <div class="mug-seo-block__inner">
      {%- if collection.metafields.custom.seo_rubrik != blank -%}
        <h2 class="mug-seo-block__rubrik">{{ collection.metafields.custom.seo_rubrik }}</h2>
      {%- endif -%}
      <div class="mug-seo-block__content" data-mug-seo-content>
        {{ mug_seo_text | metafield_tag }}
      </div>
    </div>
  </div>

{%- endif -%}

{% stylesheet %}
  .mug-seo-block {
    border-top: var(--product-card-border-width, 1px) solid rgb(var(--color-border-rgb) / var(--product-card-border-opacity, 1));
    padding: 48px 20px 56px;
  }
  .mug-seo-block__inner {
    max-width: 50%;
    margin: 0 auto;
  }
  @media screen and (max-width: 749px) {
    .mug-seo-block { padding: 32px 20px 40px; }
    .mug-seo-block__inner { max-width: 100%; }
  }
  .mug-seo-block__rubrik {
    font-size: 32px;
    line-height: 1.2;
    margin: 0 0 16px;
  }
  .mug-seo-block__content { overflow: hidden; }
  .mug-seo-block__suffix button {
    appearance: none; background: none; border: none; padding: 0;
    font: inherit; cursor: pointer;
    text-decoration: underline; text-underline-offset: 2px;
  }
  .mug-seo-block__suffix button:hover { text-decoration-thickness: 2px; }
  .mug-seo-block__content h2 {
    font-size: 20px;
    margin: 24px 0 8px;
  }
  .mug-seo-block__content p { margin: 0 0 12px; }
  .mug-seo-block__content a { text-decoration: underline; text-underline-offset: 2px; }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-mug-seo-content]').forEach(function (content) {
    var full = content.innerHTML;
    var lh = parseFloat(getComputedStyle(content).lineHeight) || 24;
    var maxH = Math.round(lh * 5) + 2;
    if (content.scrollHeight <= maxH) return;
    content.style.maxHeight = 'none';
    // göm block bortom det första tills det ryms, trimma sedan ord
    var barn = Array.prototype.slice.call(content.children);
    var passar = function () { return content.scrollHeight <= maxH; };
    var i = barn.length - 1;
    while (i > 0 && !passar()) { barn[i].style.display = 'none'; i--; }
    var sista = barn[i];
    var suffix = document.createElement('span');
    suffix.className = 'mug-seo-block__suffix';
    suffix.innerHTML = '\u2026 <button type="button">L\u00e4s mer</button>';
    sista.appendChild(suffix);
    var skydd = 400;
    while (!passar() && skydd-- > 0) {
      var noder = [];
      (function samla(n) { n.childNodes.forEach(function (c) {
        if (c === suffix) return;
        if (c.nodeType === 3) noder.push(c); else samla(c);
      }); })(sista);
      var nod = null;
      for (var j = noder.length - 1; j >= 0; j--) { if (noder[j].textContent.trim()) { nod = noder[j]; break; } }
      if (!nod) break;
      nod.textContent = nod.textContent.replace(/\s*\S+\s*$/, ' ');
      if (!nod.textContent.trim()) nod.parentNode.removeChild(nod);
    }
    suffix.querySelector('button').addEventListener('click', function () {
      content.innerHTML = full;
      content.style.maxHeight = 'none';
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "SEO-brödtext (kollektion)",
  "settings": [],
  "presets": [{ "name": "SEO-brödtext (kollektion)" }]
}
{% endschema %}
