{% comment %}
  Betygsidan (MUG 2026-09-09) — landningssida för betygsmejlen från Bakhuvudet.
  Mejlens stjärnlänkar pekar hit med ?token=…&produkt=<id>&betyg=1–5.
  Sidan hämtar orderns produkter från Bakhuvudets öppna API, låter kunden
  betygsätta varje produkt (stjärnor + frivilligt namn och text) och visar
  efter första sparade recensionen ett tack-block med Prisjakts omdömeswidget.
  Kontrakt: docs/theme-contracts/recensioner.md i mug-priskoll (etapp 3).
  Formulärklasserna (sell-form__*) delas med Sälj/byt in-formuläret.
{% endcomment %}

{%- liquid
  assign request_endpoint = section.settings.request_endpoint | default: 'https://bakhuvudet.mug.se/api/public/review-request'
  assign submit_endpoint = section.settings.submit_endpoint | default: 'https://bakhuvudet.mug.se/api/public/review-submit'
  assign widget_id = section.settings.prisjakt_widget_id | strip
-%}

<div class="section page-width-content">
  <div
    class="sell-form mug-rate"
    data-mug-rate
    data-request-endpoint="{{ request_endpoint | escape }}"
    data-submit-endpoint="{{ submit_endpoint | escape }}"
    data-prisjakt-widget-id="{{ widget_id | escape }}"
  >
    <svg class="visually-hidden" style="width: 0; height: 0;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" role="presentation">
      <defs>
        <symbol xmlns="http://www.w3.org/2000/svg" viewBox="0 0 46 46" id="mug-rate-star">
          {%- comment -%} Samma stjärna som blocks/review.liquid (star-filled.svg) {%- endcomment -%}
          <path d="M23.3048 11.3111L26.7852 18.2064L33.4839 18.87C33.6434 18.8833 33.7957 18.942 33.9229 19.0391C34.05 19.1362 34.1467 19.2678 34.2014 19.4182C34.2561 19.5685 34.2666 19.7314 34.2316 19.8876C34.1966 20.0437 34.1176 20.1866 34.004 20.2992L28.4911 25.7633L30.535 33.188C30.5768 33.3455 30.5722 33.5117 30.5218 33.6667C30.4714 33.8216 30.3773 33.9587 30.2509 34.0614C30.1244 34.1642 29.9709 34.2282 29.8089 34.2458C29.647 34.2634 29.4833 34.2338 29.3378 34.1606L22.5465 30.7977L15.7645 34.1564C15.619 34.2296 15.4553 34.2592 15.2934 34.2416C15.1314 34.224 14.9779 34.16 14.8514 34.0573C14.725 33.9545 14.6309 33.8174 14.5805 33.6625C14.53 33.5075 14.5255 33.3413 14.5673 33.1839L16.6112 25.7591L11.0942 20.2951C10.9805 20.1824 10.9015 20.0396 10.8665 19.8834C10.8315 19.7273 10.842 19.5644 10.8967 19.414C10.9515 19.2636 11.0481 19.1321 11.1753 19.0349C11.3024 18.9378 11.4548 18.8791 11.6142 18.8659L18.313 18.2022L21.7882 11.3111C21.8597 11.1715 21.9683 11.0543 22.1021 10.9725C22.2359 10.8907 22.3896 10.8474 22.5465 10.8474C22.7033 10.8474 22.8571 10.8907 22.9909 10.9725C23.1247 11.0543 23.2333 11.1715 23.3048 11.3111Z" />
        </symbol>
      </defs>
    </svg>

    <div class="mug-rate__loading" data-state="loading">
      <p class="mug-rate__loading-text">Hämtar ditt köp…</p>
    </div>

    <div data-state="form" hidden>
      <h1 class="sell-form__title">Vad tyckte du om ditt köp?</h1>
      <p class="sell-form__intro">
        Ditt betyg publiceras på produktsidan och hjälper andra musiker att välja rätt.
        Bara stjärnorna är obligatoriska, men skriv gärna några rader.
      </p>
      <div class="mug-rate__products" data-products></div>
      <div class="mug-rate__footer">
        <p class="sell-form__error" data-error hidden></p>
        <button type="button" class="sell-form__submit" data-submit>Skicka din recension</button>
      </div>
    </div>

    <div class="mug-rate__thanks" data-state="thanks" hidden>
      <h2 class="sell-form__success-title">
        <span class="sell-form__success-check" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2.81641 8.61667L4.78353 11.1458C4.84991 11.232 4.93497 11.3022 5.03231 11.3509C5.12965 11.3995 5.23675 11.4255 5.34557 11.4268C5.45264 11.4281 5.55864 11.4054 5.65586 11.3606C5.75308 11.3157 5.83908 11.2497 5.90761 11.1674L12.1837 3.57275" stroke="white" stroke-width="1.65" stroke-linecap="square"/>
          </svg>
        </span>
        Tusen tack så mycket!
      </h2>
      <p class="mug-rate__thanks-intro">Skulle du även kunna ge oss ett betyg på Prisjakt? Så blir vi superglada!</p>
      <div class="mug-rate__prisjakt-card">
        <div class="mug-rate__prisjakt-logo">{{ 'prisjakt-logo.svg' | inline_asset_content }}</div>
        <p class="mug-rate__prisjakt-fraga">Hur var din köpupplevelse på Musik Utan Gränser?</p>
        <div data-prisjakt></div>
      </div>
    </div>
  </div>
</div>

<template data-product-template>
  <section class="mug-rate__product">
    <div class="mug-rate__product-head">
      <a class="mug-rate__image-link" data-product-link><img class="mug-rate__image" alt="" width="110" height="110" loading="lazy" hidden></a>
      <div>
        <p class="mug-rate__vendor" hidden><a data-vendor data-vendor-link></a></p>
        <h2 class="mug-rate__product-title"><a data-title data-product-link></a></h2>
        <p class="mug-rate__variant" data-variant hidden></p>
        <p class="mug-rate__price" data-price hidden></p>
      </div>
    </div>
    <form class="mug-rate__form" novalidate>
      <input type="text" name="website" class="sell-form__hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <span class="sell-form__label" id="" data-stars-label>Ditt betyg:</span>
      <div class="mug-rate__stars" role="radiogroup" data-stars></div>
      <p class="sell-form__field-error" data-stars-error hidden>Välj antal stjärnor.</p>
      <label class="sell-form__label" data-name-label>Ditt förnamn: <span class="mug-rate__optional">(frivilligt)</span></label>
      <p class="sell-form__help">Förnamnet visas vid recensionen</p>
      <input class="sell-form__input" name="name" type="text" maxlength="60" autocomplete="given-name" placeholder="Ditt förnamn...">
      <label class="sell-form__label" data-body-label>Berätta gärna mer: <span class="mug-rate__optional">(frivilligt)</span></label>
      <p class="sell-form__help">Hur låter det, hur känns det, vad var bra eller mindre bra? Recensioner hjälper andra kunder att göra sitt val. Tack för att du tar dig tid!</p>
      <textarea class="sell-form__input sell-form__textarea" name="body" rows="5" maxlength="4000" placeholder="Skriv en kort recension..."></textarea>
    </form>
  </section>
</template>

<script>
  (function () {
    var root = document.querySelector('[data-mug-rate]');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';

    var params = new URLSearchParams(window.location.search);
    var token = params.get('token') || '';
    var paramProduct = params.get('produkt') || '';
    var paramRating = parseInt(params.get('betyg'), 10);
    if (!(paramRating >= 1 && paramRating <= 5)) paramRating = 0;

    var requestEndpoint = root.dataset.requestEndpoint;
    var submitEndpoint = root.dataset.submitEndpoint;
    var widgetId = root.dataset.prisjaktWidgetId || '';
    var template = document.querySelector('[data-product-template]');
    var productsRoot = root.querySelector('[data-products]');
    var prisjaktShown = false;
    var uid = 0;
    // /404 omdirigeras till startsidan i den här butiken — en okänd sidadress ger temats riktiga 404-mall
    var NOT_FOUND_URL = '/pages/recension-hittades-inte';
    var produkter = [];
    var submitButton = root.querySelector('[data-submit]');
    var globalError = root.querySelector('[data-error]');
    var skickar = false;

    // Vyerna är egna "sidor": laddning, formulär och tack (Prisjakt) visas aldrig samtidigt.
    function showState(name) {
      root.querySelectorAll('[data-state]').forEach(function (el) {
        el.hidden = el.dataset.state !== name;
      });
      window.scrollTo({ top: 0, behavior: 'auto' });
    }

    // price kommer som tal (kr) eller färdig sträng från API:t; formateras som produktsidans pris
    function formatPris(v) {
      if (v === null || v === undefined || v === '') return '';
      if (typeof v === 'string' && /kr/.test(v)) return v;
      var n = Number(v);
      if (isNaN(n)) return String(v);
      // Butikens money-format: "3,995 kr" (komma som tusentalsavgränsare, inga ören)
      return n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' kr';
    }

    function lankOn(a, url) {
      if (!url) return;
      a.href = url;
      a.target = '_blank';
      a.rel = 'noopener';
    }

    // Samma regel som snippets/vendor-collection-url.liquid: riktig varumärkeskollektion
    // när den finns, annars den automatiska /collections/vendors-sidan.
    var VENDOR_HANDLES = { 'PRS Guitars': 'prs', 'Ernie Ball Music Man': 'music-man', 'Zildjian': 'zildjan', 'Universal Audio': 'apollo', 'Ortega': 'ortega-1', 'Vintage': 'vintage-guitars' };
    function handleize(v) {
      return String(v).toLowerCase().replace(/[åä]/g, 'a').replace(/ö/g, 'o').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    }
    function vendorUrl(v) {
      var handle = VENDOR_HANDLES[v] || handleize(v);
      var fallback = '/collections/vendors?q=' + encodeURIComponent(v);
      return fetch('/collections/' + handle + '.json', { credentials: 'omit' })
        .then(function (r) { return r.ok ? '/collections/' + handle : fallback; })
        .catch(function () { return fallback; });
    }

    function starSvg() {
      var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('viewBox', '0 0 46 46');
      svg.setAttribute('aria-hidden', 'true');
      var use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
      use.setAttribute('href', '#mug-rate-star');
      svg.appendChild(use);
      return svg;
    }

    function buildStars(container, initial, labelId) {
      var value = initial || 0;
      var buttons = [];
      function paint(n) {
        buttons.forEach(function (b, i) { b.classList.toggle('is-filled', i < n); });
      }
      for (var i = 1; i <= 5; i++) {
        (function (n) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'mug-rate__star';
          b.setAttribute('role', 'radio');
          b.setAttribute('aria-label', n + (n === 1 ? ' stjärna' : ' stjärnor'));
          b.setAttribute('aria-checked', n === value ? 'true' : 'false');
          b.appendChild(starSvg());
          b.addEventListener('click', function () {
            value = n;
            buttons.forEach(function (x, i) { x.setAttribute('aria-checked', i + 1 === n ? 'true' : 'false'); });
            paint(n);
            container.dispatchEvent(new CustomEvent('rating-change'));
          });
          b.addEventListener('mouseenter', function () { paint(n); });
          b.addEventListener('mouseleave', function () { paint(value); });
          buttons.push(b);
          container.appendChild(b);
        })(i);
      }
      container.setAttribute('aria-labelledby', labelId);
      paint(value);
      return function () { return value; };
    }

    function showPrisjakt() {
      if (prisjaktShown) return;
      prisjaktShown = true;
      var thanks = root.querySelector('[data-state="thanks"]');
      if (!widgetId) {
        thanks.querySelector('.mug-rate__thanks-intro').textContent = 'Ditt betyg hjälper andra musiker att välja rätt.';
        thanks.querySelector('.mug-rate__prisjakt-card').hidden = true;
        return;
      }
      var holder = thanks.querySelector('[data-prisjakt]');
      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://cdn.pji.nu/b2b/widgets/checkout-rating/index.css';
      document.head.appendChild(css);
      var div = document.createElement('div');
      div.className = 'checkout_rating_widget';
      div.setAttribute('data-shop-id', '582');
      div.setAttribute('data-widget-id', widgetId);
      div.setAttribute('data-market', 'SE');
      holder.appendChild(div);
      var script = document.createElement('script');
      script.defer = true;
      script.id = 'checkout-rating-script';
      script.src = 'https://cdn.pji.nu/b2b/widgets/checkout-rating/index.js';
      document.body.appendChild(script);

      // Widgeten renderar i en tom (samma ursprung) iframe. Deras egen rubrik och
      // stängkryss döljs där inne — vår fråga står i stället ovanför i kortet.
      function stadaWidget() {
        var frame = holder.querySelector('iframe');
        if (!frame) return false;
        var d;
        try { d = frame.contentDocument; } catch (e) { return false; }
        if (!d || !d.head || !d.body || d.getElementById('mug-pj-style')) return !!(d && d.getElementById('mug-pj-style'));
        var st = d.createElement('style');
        st.id = 'mug-pj-style';
        // Deras rubrik, stängkryss och logga i botten (vi visar loggan själva överst)
        st.textContent = '.close-icon{display:none!important}.rating_wrapper .rating-title{display:none!important}.pj_logo_wrapper,a:has(img),a img{display:none!important}'
          + 'body{text-align:center}.main-container,.rating-wrapper,.rating_wrapper,.item-container-main,.icons-container{justify-content:center!important;align-items:center!important;text-align:center!important}';
        d.head.appendChild(st);
        return true;
      }
      // Iframen är 150 px hög oavsett innehåll — krymp till innehållet + 30 px,
      // och följ med när widgeten byter steg.
      function anpassaHojd() {
        var frame = holder.querySelector('iframe');
        if (!frame) return;
        var d;
        try { d = frame.contentDocument; } catch (e) { return; }
        if (!d || !d.body) return;
        // .modal/.widget-container sträcker sig till iframens höjd — mät innehållet i stället.
        var botten = 0;
        [].forEach.call(d.body.querySelectorAll('*'), function (el) {
          if (el.classList.contains('modal') || el.classList.contains('widget-container')) return;
          var r = el.getBoundingClientRect();
          if (r.height > 0 && r.bottom > botten) botten = r.bottom;
        });
        if (botten > 0) frame.style.height = Math.ceil(botten + 30) + 'px';
      }

      var forsok = 0;
      var timer = setInterval(function () {
        if (stadaWidget()) {
          clearInterval(timer);
          anpassaHojd();
          var frame = holder.querySelector('iframe');
          try {
            new MutationObserver(anpassaHojd).observe(frame.contentDocument.body, {
              childList: true, subtree: true, attributes: true
            });
          } catch (e) { /* iframen otillgänglig — behåll standardhöjden */ }
        } else if (++forsok > 60) {
          clearInterval(timer);
        }
      }, 250);
    }

    function renderProduct(p) {
      var node = template.content.firstElementChild.cloneNode(true);
      uid += 1;
      var id = 'mug-rate-' + uid;
      var img = node.querySelector('img');
      if (p.image) {
        // Shopify-CDN levererar originalstorlek (upp till 2048 px) — be om en liten variant.
        img.src = /cdn\.shopify\.com/.test(p.image) ? p.image + (p.image.indexOf('?') === -1 ? '?' : '&') + 'width=220' : p.image;
        img.hidden = false;
      }
      node.querySelector('[data-title]').textContent = p.title || 'Produkt';
      var vendor = node.querySelector('[data-vendor]');
      if (p.vendor) {
        vendor.textContent = p.vendor;
        vendor.parentNode.hidden = false;
        vendorUrl(p.vendor).then(function (url) { lankOn(vendor, url); });
      }
      if (p.handle) {
        node.querySelectorAll('[data-product-link]').forEach(function (a) { lankOn(a, '/products/' + encodeURIComponent(p.handle)); });
      }
      var price = node.querySelector('[data-price]');
      var prisText = formatPris(p.price);
      if (prisText) { price.textContent = prisText; price.hidden = false; }
      var variant = node.querySelector('[data-variant]');
      if (p.variantTitle && p.variantTitle !== 'Default Title') { variant.textContent = p.variantTitle; variant.hidden = false; }
      var already = p.rating !== null && p.rating !== undefined;

      var starsLabel = node.querySelector('[data-stars-label]');
      starsLabel.id = id + '-stars-label';
      node.querySelector('[data-name-label]').setAttribute('for', id + '-name');
      node.querySelector('[name="name"]').id = id + '-name';
      node.querySelector('[data-body-label]').setAttribute('for', id + '-body');
      node.querySelector('[name="body"]').id = id + '-body';

      var initial = 0;
      if (paramProduct && String(p.productId) === String(paramProduct) && paramRating) initial = paramRating;
      else if (already) initial = Number(p.rating) || 0;

      var starsEl = node.querySelector('[data-stars]');
      var getRating = buildStars(starsEl, initial, starsLabel.id);
      var starsError = node.querySelector('[data-stars-error]');
      starsEl.addEventListener('rating-change', function () { starsError.hidden = true; });

      var form = node.querySelector('form');
      form.addEventListener('submit', function (e) { e.preventDefault(); skickaAlla(); });

      productsRoot.appendChild(node);
      return {
        p: p,
        node: node,
        form: form,
        getRating: getRating,
        starsError: starsError,
        starsEl: starsEl
      };
    }

    // EN skicka-knapp för hela ordern: alla betygsatta produkter POST:as parallellt.
    function skickaAlla() {
      if (skickar) return;
      globalError.hidden = true;
      var attSkicka = produkter.filter(function (x) { return x.getRating() > 0; });
      produkter.forEach(function (x) { x.starsError.hidden = true; });
      if (attSkicka.length === 0) {
        produkter[0].starsError.hidden = false;
        produkter[0].starsEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      // Namn: tomma namnfält får det första ifyllda namnet
      var namn = '';
      produkter.forEach(function (x) { if (!namn) namn = x.form.elements.name.value.trim(); });
      skickar = true;
      submitButton.disabled = true;
      var ursprungligText = submitButton.textContent;
      submitButton.textContent = 'Skickar…';
      Promise.all(attSkicka.map(function (x) {
        var payload = {
          token: token,
          productId: String(x.p.productId),
          rating: x.getRating(),
          name: x.form.elements.name.value.trim() || namn,
          body: x.form.elements.body.value.trim(),
          website: x.form.elements.website.value
        };
        return fetch(submitEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
          .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
          .catch(function () { return { ok: false }; })
          .then(function (data) { return { x: x, ok: !!(data && data.ok), error: data && data.error }; });
      })).then(function (resultat) {
        var fel = resultat.filter(function (r) { return !r.ok; });
        if (fel.length === 0) {
          submitButton.textContent = 'Uppdatera din recension';
          showState('thanks');
          showPrisjakt();
        } else {
          globalError.textContent = fel.map(function (r) {
            return (r.x.p.title || 'Produkten') + ': ' + (r.error || 'något gick fel, försök igen om en stund.');
          }).join(' ');
          globalError.hidden = false;
          submitButton.textContent = ursprungligText;
        }
        skickar = false;
        submitButton.disabled = false;
      });
    }


    // Okänd/saknad länk ⇒ butikens vanliga 404-sida (Olles beslut 2026-09-09); laddningsvyn ligger kvar tills svaret kommit.
    function tillFyra04() { window.location.replace(NOT_FOUND_URL); }

    // Testläge: ?tack=1 visar tack-steget med Prisjakt-widgeten direkt, utan token.
    if (params.get('tack') === '1') {
      showState('thanks');
      showPrisjakt();
      return;
    }

    if (!token) { tillFyra04(); return; }
    fetch(requestEndpoint + '?token=' + encodeURIComponent(token), { cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data || !data.ok || !Array.isArray(data.products) || data.products.length === 0) { tillFyra04(); return; }
        data.products.forEach(function (p) { produkter.push(renderProduct(p)); });
        showState('form');
        submitButton.addEventListener('click', skickaAlla);
      })
      .catch(tillFyra04);
  })();
</script>

{% stylesheet %}
  /* Jämn rytm: 16 px mellan grupperna, 20 px efter ingressen */
  .mug-rate .sell-form__intro {
    margin-bottom: 20px;
  }

  .mug-rate .sell-form__label {
    margin-top: 16px;
  }

  .mug-rate__products {
    display: grid;
    gap: 28px;
    margin-top: 0;
  }

  .mug-rate__product {
    padding-top: 0;
  }

  .mug-rate__product-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 0;
  }

  .mug-rate__image {
    width: 110px;
    height: 110px;
    object-fit: contain;
    flex-shrink: 0;
    padding: 0;
    background: var(--color-background);
    border: 1px solid #E2E2E2;
    border-radius: 8px;
  }

  .mug-rate__product-title {
    font-size: var(--font-h5--size, 1.25rem);
    line-height: 1.25;
    margin: 0;
  }

  .mug-rate__product-title a,
  .mug-rate__vendor a {
    color: inherit;
    text-decoration: none;
  }

  .mug-rate__product-title a[href]:hover,
  .mug-rate__vendor a[href]:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .mug-rate__image-link {
    display: inline-flex;
    flex-shrink: 0;
  }

  .mug-rate__variant {
    margin: 4px 0 0;
    font-size: 14px;
    color: rgb(var(--color-foreground-rgb) / 0.65);
  }

  .mug-rate__vendor {
    margin: 0 0 6px;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  /* Samma typografi som produkttiteln (Olles önskemål) */
  .mug-rate__price {
    margin: 4px 0 0;
    font-size: var(--font-h5--size, 1.25rem);
    line-height: 1.25;
    font-weight: inherit;
  }

  .mug-rate__optional {
    font-weight: 400;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .mug-rate__stars {
    display: flex;
    gap: 0;
    /* canvasen bär ~9 px luft upptill — dra upp mot rubriken */
    margin-top: -2px;
    margin-left: -8px;
  }

  .mug-rate__star {
    width: 38px;
    height: 38px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  /* 46-canvasen ger ~9 px luft per sida — dra ihop stjärnorna */
  .mug-rate__star + .mug-rate__star {
    margin-left: -13px;
  }

  .mug-rate__star svg {
    width: 100%;
    height: 100%;
    fill: #D9D9D9;
  }

  .mug-rate__star.is-filled svg {
    fill: var(--color-foreground);
  }

  .mug-rate__star:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .mug-rate__link-button {
    text-align: center;
    text-decoration: none;
    max-width: 260px;
  }

  /* Tack-steget (Olles skiss 2026-09-09): centrerat, widgeten i ett kort */
  .mug-rate__thanks {
    margin-top: 8px;
  }

  /* Lika mycket luft under kortet som ovanför rubriken (58 px) */
  .sell-form:has([data-state="thanks"]:not([hidden])) {
    padding-block-end: 58px;
  }

  .mug-rate__thanks .sell-form__success-title {
    align-items: center;
    line-height: 39px;
    margin-bottom: 12px;
  }

  .mug-rate__thanks .sell-form__success-check {
    width: 24px;
    height: 24px;
  }

  .mug-rate__thanks-intro {
    margin: 0 0 28px;
    line-height: 1.5;
  }

  .mug-rate__prisjakt-card {
    border: 1px solid #E2E2E2;
    border-radius: 6px;
    /* Ingen bottenpadding: de 30 px vi sätter inuti iframen ÄR luften under ansiktena */
    padding: 32px 24px 0;
    text-align: center;
  }

  .mug-rate__prisjakt-card iframe {
    display: block;
    margin: 0 auto;
  }

  .mug-rate__prisjakt-logo {
    margin: 0 0 20px;
  }

  /* temats svg { display: block } gör att text-align inte biter — centrera med auto-marginal */
  .mug-rate__prisjakt-logo svg {
    height: 44px;
    width: auto;
    margin: 0 auto;
  }

  .mug-rate__prisjakt-fraga {
    margin: 0 0 4px;
    font-weight: 600;
    text-align: center;
  }

  /* Prisjakts widget i vårt typsnitt, utan stängkryss */
  .checkout_rating_widget,
  .checkout_rating_widget * {
    font-family: var(--font-body--family, "Inter Variable", sans-serif) !important;
  }

  .checkout_rating_widget button[aria-label="Close"],
  .checkout_rating_widget button[aria-label="Stäng"],
  .checkout_rating_widget [class*="close"] {
    display: none !important;
  }

  /* Laddningsvyn: centrerad, 15 px, 200 px luft över och under (sell-form har 50/100 i sig) */
  .mug-rate__loading {
    padding: 150px 0 100px;
    text-align: center;
  }

  .mug-rate__loading-text {
    margin: 0;
    font-size: 15px;
  }

  .mug-rate__footer {
    margin-top: 8px;
  }


{% endstylesheet %}

