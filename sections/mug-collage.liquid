{%- doc -%}
  MUG 2026-11-08 (etapp 4, ersätter Ljudhealing- och Om oss-sidornas Instant-avsnitt).
  Två spalter med bilder och texter på en färgad yta, plus valfri överrubrik/rubrik överst, ingress och knapp
  underst. Bilderna står i sin egen proportion; spalternas bredd och förskjutning är inställningar.
  Under 768 px staplas allt i en spalt (vänster spalt först).
{%- enddoc -%}
{%- liquid
  assign s = section.settings
  assign niva = s.rubrikniva | default: 'h2'
-%}
<div
  class="mug-collage{% if s.spalter_mobil %} mug-collage--spalter-mobil{% endif %}{% if s.hoger_lage == 'nederst' %} mug-collage--hoger-nederst{% elsif s.hoger_lage == 'mitten' %} mug-collage--mitten{% endif %}"
  style="
    --mc-bg: {{ s.bakgrund }}; --mc-farg: {{ s.textfarg }};
    --mc-over: {{ s.luft_over }}px; --mc-under: {{ s.luft_under }}px;
    --mc-over-mobil: {{ s.luft_over_mobil }}px; --mc-under-mobil: {{ s.luft_under_mobil }}px;
    --mc-marg: {{ s.marginal }}px; --mc-marg-mobil: {{ s.marginal_mobil }}px;{% if s.maxbredd > 0 %} --mc-max: {{ s.maxbredd }}px;{% endif %}
    --mc-v: {{ s.vanster_bredd }}%; --mc-h: {{ s.hoger_bredd }}%;
    --mc-v-ned: {{ s.vanster_forskjutning }}px; --mc-h-ned: {{ s.hoger_forskjutning }}px;
    --mc-rubrik: {{ s.rubrik_storlek }}px; --mc-rubrik-mobil: {{ s.rubrik_storlek_mobil }}px;
    --mc-rubrik-bredd: {{ s.rubrik_bredd }}%;
    --mc-ingress: {{ s.ingress_storlek }}px; --mc-ingress-bredd: {{ s.ingress_bredd }}%;
    --mc-knapp-bg: {{ s.knapp_bakgrund }}; --mc-knapp-farg: {{ s.knapp_textfarg }};
    --mc-ingress-rad: {{ s.ingress_radavstand | default: 145 | divided_by: 100.0 }};
    --mc-avstand-mobil: {{ s.avstand_mobil | default: 20 }}px;
  "
>
  {%- if s.overrubrik != blank or s.rubrik != blank -%}
    <div class="mug-collage__huvud">
      {%- if s.overrubrik != blank -%}
        <p class="mug-collage__overrubrik">{{ s.overrubrik | escape }}</p>
      {%- endif -%}
      {%- if s.rubrik != blank -%}
        <{{ niva }} class="mug-collage__rubrik">{{ s.rubrik | escape }}</{{ niva }}>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="mug-collage__spalter"{% if s.mellanrum > 0 %} style="justify-content: flex-start; column-gap: {{ s.mellanrum }}px;"{% endif %}>
      {%- assign kolumner = 'vanster,hoger' | split: ',' -%}
      {%- for kolumn in kolumner -%}
        <div class="mug-collage__spalt mug-collage__spalt--{{ kolumn }}">
          {%- for block in section.blocks -%}
            {%- if block.settings.kolumn != kolumn -%}{%- continue -%}{%- endif -%}
            {%- case block.type -%}
              {%- when 'bild' -%}
                {%- if block.settings.bild != blank -%}
                  {%- assign alt = block.settings.alt | default: block.settings.bild.alt | escape -%}
                  {%- liquid
                    if section.index <= 3
                      assign laddning = 'eager'
                      assign prio = 'high'
                    else
                      assign laddning = 'lazy'
                      assign prio = 'auto'
                    endif
                  -%}
                  {%- capture luft -%}style="{% if laddning == 'lazy' %}background-image: url({{ block.settings.bild | image_url: width: 40 }});{% endif %}{% if block.settings.luft_over > 0 %}--mc-luft: {{ block.settings.luft_over }}px;{% endif %}{% if block.settings.bredd > 0 and block.settings.bredd < 100 %} --mc-bild-bredd: {{ block.settings.bredd }}%;{% endif %}{% if block.settings.proportion > 0 %} --mc-bild-prop: 100 / {{ block.settings.proportion }};{% endif %}{% if block.settings.proportion_mobil > 0 %} --mc-bild-prop-mobil: 100 / {{ block.settings.proportion_mobil }};{% endif %}{% if block.settings.proportion_stor > 0 %} --mc-bild-prop-stor: 100 / {{ block.settings.proportion_stor }};{% endif %}"{%- endcapture -%}
                  {%- if block.settings.lank != blank -%}<a class="mug-collage__bild{% if block.settings.proportion > 0 %} mug-collage__bild--prop{% endif %}{% if laddning == 'lazy' %} mug-prog{% endif %}{% if block.settings.sist_mobil %} mug-collage--sist-mobil{% endif %}" href="{{ block.settings.lank }}" {{ luft }} {{ block.shopify_attributes }}>{%- else -%}<div class="mug-collage__bild{% if block.settings.proportion > 0 %} mug-collage__bild--prop{% endif %}{% if laddning == 'lazy' %} mug-prog{% endif %}{% if block.settings.sist_mobil %} mug-collage--sist-mobil{% endif %}" {{ luft }} {{ block.shopify_attributes }}>{%- endif -%}
                    {%- liquid
                      if kolumn == 'vanster'
                        assign andel = s.vanster_bredd | divided_by: 100.0
                      else
                        assign andel = s.hoger_bredd | divided_by: 100.0
                      endif
                      assign marg = s.marginal | times: 2
                      assign bas_vw = '100vw'
                      if s.maxbredd > 0
                        assign bas_vw = 'min(100vw, ' | append: s.maxbredd | append: 'px + ' | append: marg | append: 'px)'
                      endif
                      assign marg_mobil = s.marginal_mobil | times: 2
                      capture storlekar
                        if s.spalter_mobil
                          echo '(min-width: 768px) calc((' | append: bas_vw | append: ' - ' | append: marg | append: 'px) * ' | append: andel | append: '), calc((100vw - ' | append: marg_mobil | append: 'px) / 2)'
                        else
                          echo '(min-width: 768px) calc((' | append: bas_vw | append: ' - ' | append: marg | append: 'px) * ' | append: andel | append: '), calc(100vw - ' | append: marg_mobil | append: 'px)'
                        endif
                      endcapture
                    -%}
                    {{- block.settings.bild | image_url: width: 1800 | image_tag: widths: '360, 480, 640, 800, 960, 1100, 1300, 1500, 1800', sizes: storlekar, loading: laddning, fetchpriority: prio, alt: alt -}}
                  {%- if block.settings.lank != blank -%}</a>{%- else -%}</div>{%- endif -%}
                {%- endif -%}
              {%- when 'knapp' -%}
                {%- if block.settings.text != blank and block.settings.lank != blank -%}
                  <a class="mug-collage__blockknapp{% if block.settings.sist_mobil %} mug-collage--sist-mobil{% endif %}" href="{{ block.settings.lank }}" style="--mc-luft: {{ block.settings.luft_over }}px; background: {{ block.settings.bakgrund }}; color: {{ block.settings.textfarg }};" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</a>
                {%- endif -%}
              {%- when 'text' -%}
                <div class="mug-collage__text{% if block.settings.sist_mobil %} mug-collage--sist-mobil{% endif %}{% if block.settings.justering == 'center' %} mug-collage__text--center{% endif %}" style="{% if block.settings.storlek > 0 %}font-size: {{ block.settings.storlek }}px; {% endif %}--mc-text-bredd: {{ block.settings.bredd }}%;{% if block.settings.luft_over > 0 %} --mc-luft: {{ block.settings.luft_over }}px;{% endif %}" {{ block.shopify_attributes }}>
                  {%- if block.settings.rubrik != blank -%}
                    <h2 class="mug-collage__textrubrik">{{ block.settings.rubrik | escape }}</h2>
                  {%- endif -%}
                  {{ block.settings.text }}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if s.ingress != blank -%}
    <div class="mug-collage__ingress">{{ s.ingress }}</div>
  {%- endif -%}

  {%- if s.knapp_text != blank and s.knapp_lank != blank -%}
    <a class="mug-collage__knapp" href="{{ s.knapp_lank }}">{{ s.knapp_text | escape }}</a>
  {%- endif -%}
</div>

<script>
  (function () {
    if (window.mugProgressiv) return;
    window.mugProgressiv = true;
    function klar(img) { img.classList.add('mug-prog--klar'); }
    document.addEventListener('load', function (e) {
      if (e.target.tagName === 'IMG' && e.target.closest('.mug-prog')) klar(e.target);
    }, true);
    function kolla() {
      document.querySelectorAll('.mug-prog img').forEach(function (img) { if (img.complete && img.naturalWidth) klar(img); });
    }
    kolla();
    document.addEventListener('DOMContentLoaded', kolla);
    document.addEventListener('shopify:section:load', kolla);
  })();
</script>
<noscript><style>.mug-prog img { opacity: 1 !important; }</style></noscript>

{% stylesheet %}
  /* progressiv laddning: suddig miniatyr som bakgrund, skarp bild tonar in när den laddats */
  .mug-prog {
    background-color: rgb(127 127 127 / 0.15);
    background-position: center;
    background-size: cover;
  }

  .mug-prog img {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .mug-prog img.mug-prog--klar {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .mug-prog img { transition: none; }
  }

  .mug-collage {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--mc-over) var(--mc-marg) var(--mc-under);
    /* valfri maxbredd: innehållet centreras och marginalen växer på stora skärmar */
    padding-inline: max(var(--mc-marg), calc((100% - var(--mc-max, 100000px)) / 2));
    background: var(--mc-bg);
    color: var(--mc-farg);
  }

  .mug-collage__huvud {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-bottom: 82px;
    text-align: center;
  }

  .mug-collage__huvud:last-child {
    margin-bottom: 0;
  }

  .mug-collage__overrubrik {
    margin: 0 0 32px;
    color: inherit;
    font-size: 15px;
    line-height: 1.15;
    letter-spacing: normal;
    text-transform: uppercase;
  }

  .mug-collage__rubrik {
    max-width: var(--mc-rubrik-bredd);
    margin: 0;
    color: inherit;
    font-size: var(--mc-rubrik);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: normal;
    text-transform: none;
    text-wrap-style: pretty;
  }

  .mug-collage__spalter {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
  }

  /* mitten: spalterna blir ett rutnät så att en text centreras mot bilden bredvid (bildtexten under bilden räknas inte) */
  .mug-collage--mitten .mug-collage__spalter {
    display: grid;
    grid-template-columns: var(--mc-v) var(--mc-h);
    grid-auto-flow: dense;
    align-items: center;
    row-gap: 20px;
  }

  .mug-collage--mitten .mug-collage__spalt {
    display: contents;
  }

  .mug-collage--mitten .mug-collage__spalt--vanster > * {
    grid-column: 1;
  }

  .mug-collage--mitten .mug-collage__spalt--hoger > * {
    grid-column: 2;
  }

  .mug-collage--mitten .mug-collage__bild {
    justify-self: center;
  }

  .mug-collage--mitten .mug-collage__text--center {
    align-self: start;
  }

  .mug-collage--hoger-nederst .mug-collage__spalter {
    align-items: flex-end;
  }

  .mug-collage__spalt {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .mug-collage__spalt:empty {
    display: none;
  }

  .mug-collage__spalt--vanster {
    width: var(--mc-v);
    margin-top: var(--mc-v-ned);
  }

  .mug-collage__spalt--hoger {
    width: var(--mc-h);
    margin-top: var(--mc-h-ned);
  }

  .mug-collage__bild,
  .mug-collage__text {
    margin-top: var(--mc-luft, 0px);
  }

  .mug-collage__bild {
    display: block;
    width: var(--mc-bild-bredd, 100%);
    align-self: center;
  }

  .mug-collage__bild img {
    display: block;
    width: 100%;
    height: auto;
  }

  .mug-collage__bild--prop img {
    aspect-ratio: var(--mc-bild-prop);
    object-fit: cover;
  }

  @media (min-width: 1600px) {
    .mug-collage__bild--prop img {
      aspect-ratio: var(--mc-bild-prop-stor, var(--mc-bild-prop));
    }
  }

  .mug-collage__text--center {
    align-self: center;
    text-align: center;
  }

  .mug-collage__text {
    max-width: var(--mc-text-bredd, 100%);
    font-size: 15px;
    line-height: 1.6;
    text-wrap-style: pretty;
  }

  .mug-collage__textrubrik {
    margin: 0 0 16px;
    padding-top: 40px;
    color: inherit;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: normal;
    text-transform: none;
  }

  .mug-collage__text p,
  .mug-collage__ingress p {
    margin: 0;
    color: inherit;
  }

  .mug-collage__text p + p {
    margin-top: 1.6em;
  }

  .mug-collage__text a,
  .mug-collage__ingress a {
    color: inherit;
  }

  .mug-collage__ingress {
    max-width: var(--mc-ingress-bredd);
    margin-top: 92px;
    font-size: var(--mc-ingress);
    line-height: var(--mc-ingress-rad);
    text-align: center;
    text-wrap-style: pretty;
  }

  .mug-collage__ingress:first-child {
    margin-top: 0;
  }

  .mug-collage__knapp {
    display: inline-flex;
    padding: 20px 24px;
    background: var(--mc-knapp-bg);
    color: var(--mc-knapp-farg);
    font-size: 14px;
    line-height: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .mug-collage__blockknapp {
    align-self: flex-start;
    margin-top: var(--mc-luft, 0px);
    padding: 14px 18px;
    border-radius: 2px;
    font-size: 15px;
    line-height: 17px;
    text-decoration: none;
  }

  .mug-collage__blockknapp:hover {
    opacity: 0.85;
  }

  .mug-collage__knapp:hover {
    opacity: 0.85;
  }

  * + .mug-collage__knapp {
    margin-top: 60px;
  }

  @media (max-width: 767px) {
    .mug-collage {
      padding: var(--mc-over-mobil) var(--mc-marg-mobil) var(--mc-under-mobil);
    }

    .mug-collage__huvud {
      margin-bottom: 60px;
      padding-inline: 8px;
    }

    .mug-collage__rubrik {
      max-width: 100%;
      font-size: var(--mc-rubrik-mobil);
    }

    .mug-collage__spalter,
    .mug-collage--mitten .mug-collage__spalter {
      display: flex;
      flex-direction: column;
      gap: var(--mc-avstand-mobil) !important;
    }

    .mug-collage__spalt {
      gap: var(--mc-avstand-mobil);
    }

    .mug-collage__bild {
      width: 100%;
    }

    /* spalterna löses upp så att block kan flyttas sist (Instant-sidornas mobilordning) */
    .mug-collage__spalt {
      display: contents;
    }

    .mug-collage--sist-mobil {
      order: 1;
    }

    .mug-collage__bild--prop img {
      aspect-ratio: var(--mc-bild-prop-mobil, var(--mc-bild-prop));
    }

    /* behåll spalterna sida vid sida i mobil */
    .mug-collage--spalter-mobil .mug-collage__spalter {
      flex-direction: row;
    }

    .mug-collage--spalter-mobil .mug-collage__spalt {
      display: flex;
      flex-direction: column;
      flex: 1 1 0;
      min-width: 0;
    }

    /* centrerad bildtext direkt efter sin bild hålls nära bilden */
    .mug-collage__bild + .mug-collage__text--center {
      margin-top: calc(20px - var(--mc-avstand-mobil));
    }

    .mug-collage__bild,
    .mug-collage__text {
      margin-top: calc(var(--mc-luft, 0px) / 2);
    }

    .mug-collage__text {
      max-width: 100%;
    }

    .mug-collage__ingress {
      max-width: 100%;
      margin-top: 72px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MUG bildcollage",
  "tag": "section",
  "class": "mug-collage-sektion",
  "settings": [
    { "type": "color", "id": "bakgrund", "label": "Bakgrund", "default": "#301f05" },
    { "type": "color", "id": "textfarg", "label": "Textfärg", "default": "#ffffff" },
    { "type": "header", "content": "Rubrik (valfri)" },
    { "type": "text", "id": "overrubrik", "label": "Överrubrik" },
    { "type": "text", "id": "rubrik", "label": "Rubrik" },
    {
      "type": "select",
      "id": "rubrikniva",
      "label": "Rubriknivå",
      "options": [
        { "value": "h1", "label": "H1 (sidans huvudrubrik)" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h2"
    },
    { "type": "number", "id": "rubrik_storlek", "label": "Rubrikens storlek (px)", "default": 60 },
    { "type": "number", "id": "rubrik_storlek_mobil", "label": "Rubrikens storlek, mobil (px)", "default": 42 },
    { "type": "number", "id": "rubrik_bredd", "label": "Rubrikens bredd (%)", "default": 60 },
    { "type": "header", "content": "Spalter" },
    { "type": "paragraph", "content": "Lägg till bilder och texter som block och välj spalt för varje block." },
    { "type": "number", "id": "vanster_bredd", "label": "Vänster spalts bredd (%)", "default": 58 },
    { "type": "number", "id": "hoger_bredd", "label": "Höger spalts bredd (%)", "default": 35 },
    { "type": "number", "id": "vanster_forskjutning", "label": "Vänster spalt nedflyttad (px)", "default": 0 },
    { "type": "number", "id": "hoger_forskjutning", "label": "Höger spalt nedflyttad (px)", "default": 0 },
    { "type": "number", "id": "mellanrum", "label": "Fast avstånd mellan spalterna (px, 0 = spalterna mot var sin kant)", "default": 0 },
    { "type": "number", "id": "avstand_mobil", "label": "Avstånd mellan blocken, mobil (px)", "default": 20 },
    { "type": "checkbox", "id": "spalter_mobil", "label": "Behåll spalterna sida vid sida i mobil", "default": false },
    {
      "type": "select",
      "id": "hoger_lage",
      "label": "Spalternas lodräta läge",
      "options": [
        { "value": "overst", "label": "Överkant mot överkant" },
        { "value": "nederst", "label": "Nederkant mot nederkant" },
        { "value": "mitten", "label": "Mitten mot mitten (text mot bild)" }
      ],
      "default": "overst"
    },
    { "type": "header", "content": "Ingress och knapp (valfria, underst)" },
    { "type": "richtext", "id": "ingress", "label": "Ingress" },
    { "type": "number", "id": "ingress_storlek", "label": "Ingressens storlek (px)", "default": 20 },
    { "type": "number", "id": "ingress_bredd", "label": "Ingressens bredd (%)", "default": 74 },
    { "type": "number", "id": "ingress_radavstand", "label": "Ingressens radavstånd (%)", "default": 145 },
    { "type": "text", "id": "knapp_text", "label": "Knapptext" },
    { "type": "url", "id": "knapp_lank", "label": "Knapplänk" },
    { "type": "color", "id": "knapp_bakgrund", "label": "Knappens bakgrund", "default": "#ffffff" },
    { "type": "color", "id": "knapp_textfarg", "label": "Knappens textfärg", "default": "#2f1b1b" },
    { "type": "header", "content": "Luft" },
    { "type": "number", "id": "luft_over", "label": "Över (px)", "default": 100 },
    { "type": "number", "id": "luft_under", "label": "Under (px)", "default": 100 },
    { "type": "number", "id": "marginal", "label": "Sidmarginal (px)", "default": 86 },
    { "type": "number", "id": "maxbredd", "label": "Innehållets maxbredd (px, 0 = ingen)", "default": 0 },
    { "type": "number", "id": "luft_over_mobil", "label": "Över, mobil (px)", "default": 60 },
    { "type": "number", "id": "luft_under_mobil", "label": "Under, mobil (px)", "default": 60 },
    { "type": "number", "id": "marginal_mobil", "label": "Sidmarginal, mobil (px)", "default": 20 }
  ],
  "blocks": [
    {
      "type": "bild",
      "name": "Bild",
      "settings": [
        { "type": "image_picker", "id": "bild", "label": "Bild" },
        { "type": "text", "id": "alt", "label": "Alt-text (annars bildens egen)" },
        { "type": "url", "id": "lank", "label": "Länk" },
        { "type": "number", "id": "luft_over", "label": "Extra luft över (px)", "default": 0 },
        { "type": "number", "id": "bredd", "label": "Bredd (% av spalten, centrerad)", "default": 100 },
        { "type": "number", "id": "proportion", "label": "Höjd i % av bredden (0 = bildens egen, annars beskärs den)", "default": 0 },
        { "type": "number", "id": "proportion_mobil", "label": "Höjd i % av bredden, mobil (0 = som ovan)", "default": 0 },
        { "type": "number", "id": "proportion_stor", "label": "Höjd i % av bredden, skärmar ≥1600 px (0 = som ovan)", "default": 0 },
        { "type": "checkbox", "id": "sist_mobil", "label": "Sist i mobil (efter båda spalterna)", "default": false },
        {
          "type": "select",
          "id": "kolumn",
          "label": "Spalt",
          "options": [
            { "value": "vanster", "label": "Vänster" },
            { "value": "hoger", "label": "Höger" }
          ],
          "default": "vanster"
        }
      ]
    },
    {
      "type": "knapp",
      "name": "Knapp",
      "settings": [
        { "type": "text", "id": "text", "label": "Knapptext" },
        { "type": "url", "id": "lank", "label": "Länk" },
        { "type": "color", "id": "bakgrund", "label": "Bakgrund", "default": "#000000" },
