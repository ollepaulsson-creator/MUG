{%- comment -%}
  Renders a Shopify policy page (refund, privacy, terms, shipping) inside a
  custom policy template. Shopify exposes the policy heading as page_title and
  the policy body HTML as page_description on /policies/* pages.

  Layout (2026-09-19): sidonavigering till vänster mellan de policysidor som
  hör ihop (samma namn som i footermenyn), och en egen typografisk skala för
  brödtexten — temats .rte-rubriker är byggda för kampanjsidor och gör H2 lika
  stor som H1 (48 px) i en villkorstext. På mobil blir navigeringen chips
  ovanför texten.
{%- endcomment -%}
{%- assign current_path = request.path -%}
<div class="section page-width color-{{ section.settings.color_scheme }}">
  <div
    class="policy-page spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <nav class="policy-nav" aria-label="Villkor och policyer">
      <p class="policy-nav__heading">Villkor</p>
      <ul class="policy-nav__list">
        {%- assign items = 'shipping|Frakt & leverans,refund|Retur & återbetalning,terms|Köpvillkor,privacy|Integritetspolicy,choices|Dina integritetsval' | split: ',' -%}
        {%- for item in items -%}
          {%- assign parts = item | split: '|' -%}
          {%- assign key = parts[0] -%}
          {%- assign label = parts[1] -%}
          {%- case key -%}
            {%- when 'shipping' -%}{%- assign href = shop.shipping_policy.url -%}
            {%- when 'refund' -%}{%- assign href = shop.refund_policy.url -%}
            {%- when 'terms' -%}{%- assign href = shop.terms_of_service.url -%}
            {%- when 'privacy' -%}{%- assign href = shop.privacy_policy.url -%}
            {%- else -%}{%- assign href = '/pages/data-sharing-opt-out' -%}
          {%- endcase -%}
          {%- if href == blank -%}{%- continue -%}{%- endif -%}
          {%- assign is_current = false -%}
          {%- if current_path == href -%}{%- assign is_current = true -%}{%- endif -%}
          <li class="policy-nav__item{% if is_current %} policy-nav__item--current{% endif %}">
            <a class="policy-nav__link" href="{{ href }}"{% if is_current %} aria-current="page"{% endif %}>{{ label }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <article class="policy-page__content">
      <h1 class="policy-page__title">{{ page_title }}</h1>
      <div class="rte policy-page__body">
        {{ page_description }}
      </div>
    </article>
  </div>
</div>

{% stylesheet %}
  .policy-page {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 990px) {
    .policy-page {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
    .policy-nav {
      position: sticky;
      top: calc(var(--header-height, 0px) + 2rem);
    }
  }

  /* ── Sidonavigering ── */
  .policy-nav__heading {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(0 0 0 / 0.55);
  }
  .policy-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .policy-nav__link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    font-size: 0.9375rem;
    line-height: 1.4;
    text-decoration: none;
    color: rgb(0 0 0 / 0.7);
    transition: background-color 120ms ease, color 120ms ease;
  }
  .policy-nav__link:hover {
    background: rgb(0 0 0 / 0.04);
    color: rgb(0 0 0 / 1);
  }
  .policy-nav__item--current .policy-nav__link {
    background: rgb(0 0 0 / 0.06);
    color: rgb(0 0 0 / 1);
    font-weight: 600;
  }

  /* Mobil: horisontella chips ovanför texten */
  @media screen and (max-width: 989px) {
    .policy-nav__heading { display: none; }
    .policy-nav__list {
      flex-direction: row;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 0.5rem;
      padding-bottom: 0.25rem;
      margin-inline: calc(-1 * var(--page-margin, 16px));
      padding-inline: var(--page-margin, 16px);
      scrollbar-width: none;
    }
    .policy-nav__list::-webkit-scrollbar { display: none; }
    .policy-nav__item { flex: 0 0 auto; }
    .policy-nav__link {
      border: 1px solid rgb(0 0 0 / 0.12);
      border-radius: 999px;
      padding: 0.4rem 0.9rem;
      font-size: 0.875rem;
      white-space: nowrap;
    }
    .policy-nav__item--current .policy-nav__link {
      background: rgb(0 0 0 / 1);
      color: #fff;
      border-color: rgb(0 0 0 / 1);
    }
  }

  /* ── Typografisk skala för villkorstext ── */
  .policy-page__content {
    max-width: 68ch;
  }
  .policy-page__title {
    font-size: clamp(1.875rem, 1.4rem + 1.6vw, 2.5rem);
    line-height: 1.15;
    margin: 0 0 1.5rem;
  }
  .policy-page__body {
    font-size: 1rem;
    line-height: 1.65;
  }
  .policy-page__body > :first-child { margin-top: 0; }
  .policy-page__body h2 {
    font-size: 1.375rem;
    line-height: 1.3;
    font-weight: 600;
    margin: 2.5rem 0 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(0 0 0 / 0.08);
  }
  .policy-page__body h3 {
    font-size: 1.0625rem;
    line-height: 1.4;
    font-weight: 600;
    margin: 1.5rem 0 0.375rem;
  }
  .policy-page__body h4 {
    font-size: 1rem;
    font-weight: 600;
    margin: 1.25rem 0 0.25rem;
  }
  .policy-page__body p {
    margin: 0 0 1rem;
  }
  .policy-page__body ul,
  .policy-page__body ol {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }
  .policy-page__body li {
    margin-bottom: 0.4rem;
  }
  .policy-page__body a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Policy",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
