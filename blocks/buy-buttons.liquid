
{% liquid
  assign block_settings = block.settings
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign variant = closest.product.selected_or_first_available_variant
  assign inventory_quantity = variant.inventory_quantity
  assign inventory_policy = variant.inventory_policy

  if variant.inventory_management == 'shopify'
    assign inventory_managed = true
  endif

  if variant.quantity_rule.min > variant.inventory_quantity and inventory_managed and inventory_policy == 'deny'
    assign quantity_rule_soldout = true
  endif

  if inventory_managed
    comment
      ── Tomt spårat lager = slutsålt, OAVSETT inventory policy ──
      Tidigare krävdes policy 'deny' här, så en CONTINUE-produkt utan lager
      förblev köpbar och produktsidan lovade "Leverans 1–3 arbetsdagar" för
      något butiken inte kan skicka. CONTINUE ska bara öppna för köp när det
      finns ett medvetet beslut bakom — och det beslutet är en förhandskampanj,
      som sätter can_add_to_cart tillbaka till true längre ner.

      OBS: villkoret löd tidigare "qty <= 0 and policy == 'deny' or
      quantity_rule_soldout". Liquid binder höger-till-vänster, så det
      betydde qty <= 0 and (deny or quantity_rule_soldout) — dvs
      quantity_rule_soldout kunde aldrig ensamt göra en vara slutsåld.
      Den latenta buggen lämnas orörd här; att aktivera den vore en
      separat beteendeändring för produkter med minsta orderantal.
    endcomment
    if inventory_quantity <= 0
      assign can_add_to_cart = false
      assign add_to_cart_text = 'products.product.sold_out' | t
    else
      assign can_add_to_cart = true
      assign add_to_cart_text = 'products.product.add_to_cart' | t
    endif
  else
    if closest.product.selected_or_first_available_variant != null
      assign can_add_to_cart = true
      assign add_to_cart_text = 'products.product.add_to_cart' | t
    else
      assign can_add_to_cart = false
      assign add_to_cart_text = 'products.product.unavailable' | t
    endif
  endif

  comment
    ── Förhandsbeställning (fryst kontrakt: mug-priskoll/docs/theme-contracts/preorder.md).
    Verktyget i Bakhuvudet sätter mug.preorder (json) + inventoryPolicy CONTINUE
    när en förhandskampanj är aktiv, och raderar fältet när den slutar. ends_at
    är bara ett hängslen-skydd om fältet skulle ligga kvar.
  endcomment
  assign mug_preorder = product.metafields.mug.preorder.value
  assign mug_is_preorder = false
  if mug_preorder
    assign mug_pre_now = 'now' | date: '%s' | plus: 0
    if mug_preorder.ends_at != blank
      assign mug_pre_end = mug_preorder.ends_at | date: '%s' | plus: 0
      if mug_pre_now <= mug_pre_end
        assign mug_is_preorder = true
      endif
    else
      assign mug_is_preorder = true
    endif
  endif
  if mug_is_preorder
    assign can_add_to_cart = true
    assign add_to_cart_text = mug_preorder.button_text | default: 'Förhandsbeställ nu'
  endif

  comment
    ── Tillbaka i lager (fryst kontrakt: preorder.md §6–10). Bevakningsknapp
    under Slutsåld-knappen: samma slutsåldvillkor som ovan (spårat lager ≤ 0),
    aldrig på förhandsvaror, aldrig för produkter i kollektioner listade i
    shop.metafields.mug.bis_excluded. Servern kontrollerar också undantagen —
    temat döljer knappen så kunden aldrig ser något som ändå avvisas.
  endcomment
  assign mug_bis_show = false
  if inventory_managed and inventory_quantity <= 0 and mug_is_preorder == false and variant != null
    assign mug_bis_show = true
    assign mug_bis_excluded = shop.metafields.mug.bis_excluded.value
    if mug_bis_excluded
      assign mug_product_handles = product.collections | map: 'handle'
      for mug_bis_handle in mug_bis_excluded
        if mug_product_handles contains mug_bis_handle
          assign mug_bis_show = false
          break
        endif
      endfor
    endif
  endif
%}

<span
  class="buy-buttons-block buy-buttons-block--{{ block.id }}"
  {{ block.shopify_attributes }}
>
  {%- if product != blank -%}
    {%- assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id -%}
    <product-form-component
      data-section-id="{{ section.id }}"
      data-product-id="{{ product.id }}"
      data-product-url="{{ product.url }}"
      on:submit="/handleSubmit"
      data-quantity-default="{% if product.selected_or_first_available_variant.quantity_rule.min %}{{ product.selected_or_first_available_variant.quantity_rule.min }}{% else %}1{% endif %}"
    >
      <div
        class="visually-hidden"
        aria-live="assertive"
        role="status"
        aria-atomic="true"
        ref="liveRegion"
      ></div>
      {%- form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' -%}
        <input
          type="hidden"
          name="id"
          ref="variantId"
          value="{{ product.selected_or_first_available_variant.id }}"
        >
        {%- if mug_is_preorder -%}
          {%- comment -%} Synlig radegenskap — följer med till kassa, mail och följesedel. {%- endcomment -%}
          <input type="hidden" name="properties[Skickas]" value="{{ mug_preorder.shipping_message | escape }}">
        {%- endif -%}
        {%- if block_settings.gift_card_form and product.gift_card? -%}
          {%- render 'gift-card-recipient-form', product: product, form: form, section: section, block: block -%}
        {%- endif -%}
        <div
          class="product-form-buttons spacing-style{% if block_settings.stacking %} product-form-buttons--stacked{% endif %}{% if mug_is_preorder %} product-form-buttons--preorder{% endif %}"
          style="{% render 'spacing-style', settings: block_settings %}"
        >
          {% content_for 'block', type: 'quantity', id: 'quantity' %}

          {% content_for 'block',
            type: 'add-to-cart',
            id: 'add-to-cart',
            can_add_to_cart: can_add_to_cart,
            add_to_cart_text: add_to_cart_text
          %}
          {%- unless block_settings.gift_card_form and product.gift_card? -%}
            <span
              class="product-form-text__error hidden"
              ref="addToCartTextError"
            >
              <span class="svg-wrapper product-form-icon--error">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
            </span>
          {%- endunless -%}
          {%- comment -%}
            Förhandsbeställning visar EN köpknapp. Snabbkassan ("Köp nu") döljs:
            två jämbördiga CTA:n gör det otydligt att köpet är en förbokning,
            och förhandsknappens egen text är hela poängen.
          {%- endcomment -%}
          {%- unless mug_is_preorder -%}
            {% content_for 'block',
              type: 'accelerated-checkout',
              id: 'accelerated-checkout',
              can_add_to_cart: can_add_to_cart,
              form_obj: form
            %}
          {%- endunless -%}
        </div>
        {%- if mug_is_preorder and mug_preorder.shipping_message != blank -%}
          <div class="mug-campaign-notice mug-preorder-shipping">
            <strong>Skickas:</strong> {{ mug_preorder.shipping_message }}
          </div>
        {%- endif -%}
      {%- endform -%}
      {%- if mug_bis_show -%}
        {%- comment -%} Utanför produktformuläret — dialogens formulär får inte nästlas i det. {%- endcomment -%}
        <div
          class="mug-bis"
          data-endpoint="https://mug-priskoll.vercel.app/api/public/bis-signup"
          data-variant-gid="gid://shopify/ProductVariant/{{ variant.id }}"
          data-product-gid="gid://shopify/Product/{{ product.id }}"
          data-sku="{{ variant.sku | escape }}"
          data-product-title="{{ product.title | escape }}"
          data-variant-title="{% unless variant.title == 'Default Title' %}{{ variant.title | escape }}{% endunless %}"
        >
          <button type="button" class="button button-secondary mug-bis__open">
            Meddela mig när den finns i lager
          </button>
          <dialog class="mug-bis__dialog">
            <form class="mug-bis__form" novalidate>
              <button type="button" class="mug-bis__close mug-bis__x" aria-label="Stäng">
                <span class="svg-wrapper">{{ 'icon-close.svg' | inline_asset_content }}</span>
              </button>
              <h3 class="mug-bis__heading">Meddela mig när den finns i lager</h3>
              <p class="mug-bis__product">{{ product.title }}{% unless variant.title == 'Default Title' %} – {{ variant.title }}{% endunless %}</p>
              <input
                type="email"
                name="email"
                class="mug-bis__email"
                placeholder="Din e-postadress"
                autocomplete="email"
                required
              >
              <input
                type="text"
                name="honeypot"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
                style="position:absolute;left:-9999px;opacity:0;height:0;width:0;"
              >
              <p class="mug-bis__gdpr">Vi mejlar dig en gång när varan finns i lager. Inget nyhetsbrev, ingen reklam.</p>
              <p class="mug-bis__status" role="status" aria-live="polite"></p>
              <div class="mug-bis__actions">
                <button type="submit" class="button mug-bis__submit">Bevaka</button>
              </div>
            </form>
          </dialog>
        </div>
      {%- endif -%}
    </product-form-component>
  {%- else -%}
    <div class="product-form-buttons">
      <button
        type="submit"
        name="add"
        class="button"
        disabled
      >
        {{ 'blocks.sold_out' | t }}
      </button>
    </div>
  {%- endif -%}
</span>

{% if block_settings.show_pickup_availability %}
  <script
    src="{{ 'local-pickup.js' | asset_url }}"
    type="module"
  ></script>

  {%- assign pick_up_availabilities = closest.product.selected_or_first_available_variant.store_availabilities
    | where: 'pick_up_enabled', true
  -%}

  <local-pickup
    class="spacing-style product__pickup-availabilities"
    {% if pick_up_availabilities.size == 0 %}
      hidden
    {% endif %}
    data-section-id="{{ section.id }}"
    data-product-url="{{ closest.product.url }}"
    data-variant-id="{{ closest.product.selected_or_first_available_variant.id }}"
    style="{% render 'spacing-style', settings: block_settings %}"
    ref="localPickupButton"
  >
    {% if can_add_to_cart %}
      <dialog-component>
        <div class="pickup-availability__row">
          <div class="pickup-availability__column">
            <span class="svg-wrapper">
              {% if pick_up_availabilities.first.available %}
                {{- 'icon-available.svg' | inline_asset_content -}}
              {% else %}
                {{- 'icon-unavailable.svg' | inline_asset_content -}}
              {% endif %}
            </span>
          </div>
          <div class="pickup-availability__column">
            {% if pick_up_availabilities.first.available %}
              <p class="pickup-location__text-sm">
                {{ 'content.pickup_available_at_html' | t: location: pick_up_availabilities.first.location.name }}
              </p>
              <p class="pickup-location__text-xs">
                {{ 'content.pickup_ready_in' | t: pickup_time: pick_up_availabilities.first.pick_up_time }}
              </p>
            {% else %}
              <p class="pickup-location__text-sm">
                {{ 'content.pickup_not_available' | t }}
              </p>
            {% endif %}
            <button
              on:click="/showDialog"
              class="button-unstyled pickup-location__button"
            >
              {{ 'actions.view_store_information' | t }}
            </button>
          </div>
        </div>
        <dialog
          ref="dialog"
          class="dialog-modal dialog-drawer pickup-location__dialog color-{{ settings.drawer_color_scheme }}"
          scroll-lock
        >
          <div class="pickup-availability__dialog-row pickup-availability__header-container">
            <div class="pickup-availability__column">
              <h4 class="pickup-location__h4">{{ closest.product.title }}</h4>
              <p class="pickup-location__text-sm">
                {{ closest.product.selected_or_first_available_variant.title }}
              </p>
            </div>
            <button
              ref="closeButton"
              on:click="/closeDialog"
              class="button button-unstyled close-button pickup-location__close-button"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
          {% for pick_up_availability in pick_up_availabilities %}
            <div class="pickup-location__wrapper">
              <p class="pickup-location__text-bold">{{ pick_up_availability.location.name }}</p>
              <div class="pickup-location__address-wrapper">
                <span class="pickup-location__availability-wrapper">
                  {% if pick_up_availability.available %}
                    {{- 'icon-available.svg' | inline_asset_content -}}
                    {% assign pickup_time = pick_up_availability.pick_up_time | downcase %}
                    {{ 'content.pickup_available_in' | t: pickup_time: pickup_time }}
                  {% else %}
                    {{- 'icon-unavailable.svg' | inline_asset_content -}}
                    {{ 'content.pickup_not_available' | t }}
                  {% endif %}
                </span>
                <address class="pickup-location__address">
                  {{ pick_up_availability.location.address | format_address }}
                  {{ pick_up_availability.location.address.phone }}
                </address>
              </div>
            </div>
          {% endfor %}
        </dialog>
      </dialog-component>
    {% endif %}
  </local-pickup>
{% endif %}

{%- comment %} ── Kampanjnotis (Temainställningar → Kampanjbadge): visas under
  köpknapparna, ovanför beskrivningen, för produkter i kampanjserien inom
  kampanjens datumfönster. Endast produktsidor. ── {%- endcomment -%}
{%- comment %} ── Kampanjnotis — två spår under övergången:
  1) METAFÄLT (primärt): kampanjmotorn i Bakhuvudet skriver
     shop.metafields.mug.campaign (json) + product.metafields.mug.campaign
     (= kampanj-id). Kontrakt: spec §6.1 steg 6.
  2) TEMAINSTÄLLNINGAR (utfasas när TE-kampanjen löpt ut 7 aug). ── {%- endcomment -%}
{%- if request.page_type == 'product' -%}
  {%- assign mug_now = 'now' | date: '%s' | plus: 0 -%}
  {%- assign mug_notice_text = blank -%}

  {%- assign mug_shop_campaign = shop.metafields.mug.campaign.value -%}
  {%- if mug_shop_campaign and mug_shop_campaign.active -%}
    {%- if closest.product.metafields.mug.campaign.value == mug_shop_campaign.id -%}
      {%- assign mf_start = mug_shop_campaign.starts_at | date: '%s' | plus: 0 -%}
      {%- assign mf_end = mug_shop_campaign.ends_at | date: '%s' | plus: 0 -%}
      {%- if mug_now >= mf_start and mug_now <= mf_end -%}
        {%- assign mug_notice_text = mug_shop_campaign.notice_text -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- if mug_notice_text == blank and settings.campaign_badge_active and settings.campaign_badge_collection != blank -%}
    {%- assign mug_window_ok = true -%}
    {%- if settings.campaign_badge_start != blank -%}
      {%- assign mug_cb_start = settings.campaign_badge_start | date: '%s' | plus: 0 -%}
      {%- if mug_cb_start > mug_now -%}{%- assign mug_window_ok = false -%}{%- endif -%}
    {%- endif -%}
    {%- if settings.campaign_badge_end != blank -%}
      {%- assign mug_cb_end = settings.campaign_badge_end | date: '%s' | plus: 0 -%}
      {%- if mug_now > mug_cb_end -%}{%- assign mug_window_ok = false -%}{%- endif -%}
    {%- endif -%}
    {%- if mug_window_ok -%}
      {%- assign mug_campaign_handles = closest.product.collections | map: 'handle' -%}
      {%- if mug_campaign_handles contains settings.campaign_badge_collection.handle -%}
        {%- assign mug_notice_text = settings.campaign_badge_text_long | default: 'Rabatten dras automatiskt av i kassan.' -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- if mug_notice_text != blank -%}
    <div class="mug-campaign-notice">
      <strong>Kampanj:</strong> {{ mug_notice_text }}
    </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .mug-campaign-notice {
    display: block;
    margin-top: 2px;
    margin-bottom: 2px;
    padding: 10px 14px;
    border-radius: 2px;
    /* Ärvd font-family här är "Inter Variable" som inte laddas på
       produktsidor — då faller texten till system-sans utan 500-snitt och
       prefixet ser regular ut. Temats riktiga Inter har 400/500/700. */
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.5;
    background: #f2f2f2;
  }

  .mug-campaign-notice strong {
    font-weight: 700;
  }

  /* Ärver den grå rutan från .mug-campaign-notice — samma visuella språk som
     kampanjbeskrivningen, bara med prefixet "Skickas:". */
  .mug-preorder-shipping {
    margin-top: 8px;
  }

  /* ── Tillbaka i lager (kontrakt: preorder.md §6–10) ── */
  .mug-bis {
    display: block;
    margin-top: 8px;
  }

  .mug-bis__open {
    width: 100%;
    /* Svart primärknapp — samma temavariabler som förhandsknappen använder. */
    --button-color: var(--color-primary-button-text);
    --button-background-color: var(--color-primary-button-background);
    --button-border-color: var(--color-primary-button-border);
  }

  .mug-bis__dialog {
    margin: auto;
    padding: 24px;
    max-width: 400px;
    width: calc(100% - 32px);
    border: 0;
    border-radius: 2px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
    background: #fff;
    font-family: var(--font-body--family);
  }

  .mug-bis__x {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 6px;
    background: none;
    border: 0;
    cursor: pointer;
    line-height: 0;
  }

  .mug-bis__x svg {
    width: 16px;
    height: 16px;
  }

  .mug-bis__dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
  }

  .mug-bis__heading {
    margin: 0 0 4px;
    font-size: 16px;
  }

  .mug-bis__product {
    margin: 0 0 16px;
    font-size: 13px;
    color: rgba(0, 0, 0, 0.65);
  }

  .mug-bis__email {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #dcdcdc;
    border-radius: 0;
    font-size: 16px; /* iOS: förhindrar autozoom */
    font-family: inherit;
    -webkit-appearance: none;
  }

  .mug-bis__gdpr {
    margin: 10px 0 0;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.65);
  }

  .mug-bis__status {
    margin: 10px 0 0;
    font-size: 13px;
    line-height: 1.5;
  }

  .mug-bis__status:empty {
    display: none;
  }

  .mug-bis__actions {
    display: flex;
    gap: 8px;
    margin-top: 16px;
  }

  .mug-bis__actions .button {
    flex: 1;
  }

  .mug-bis--done .mug-bis__email,
  .mug-bis--done .mug-bis__gdpr,
  .mug-bis--done .mug-bis__submit {
    display: none;
  }

  /* Förhandsknappen är sidans enda CTA (snabbkassan döljs ovan), så den ska
     bära primärknappens svarta utseende trots att add-to-cart-blocket är
     inställt på "sekundär" för vanliga produkter. Färgerna kommer från temats
     egna primärvariabler så den följer med om butiken byter färgtema. */
  .product-form-buttons--preorder .add-to-cart-button {
    --button-color: var(--color-primary-button-text);
    --button-background-color: var(--color-primary-button-background);
    --button-border-color: var(--color-primary-button-border);
    --button-border-width: var(--style-border-width-primary);

    border-radius: var(--style-border-radius-buttons-primary);
  }

  .product-form-buttons--preorder .add-to-cart-button:hover {
    --button-color: var(--color-primary-button-hover-text);
    --button-background-color: var(--color-primary-button-hover-background);
    --button-border-color: var(--color-primary-button-hover-border);
  }

  .buy-buttons-block {
    width: 100%;
  }

  .product-form-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--gap-xl) / 2);

    @media screen and (min-width: 750px) {
      gap: var(--gap-md);
    }
  }

  .product-form-buttons > *:not(.quantity-selector) {
    flex: 1 1 185px;
    min-width: fit-content;
  }

  .product-form-buttons--stacked > *:not(.quantity-selector) {
    flex-basis: 51%; /* Force the buttons to be on separate rows */
  }

  .quantity-selector {
    flex-grow: 0;
  }

  .product-form-buttons button {
    width: 100%;
    padding-inline: var(--padding-4xl);
    padding-block: var(--padding-lg);
  }

  .add-to-cart-button {
    text-transform: var(--button-text-case-primary);
  }

  .add-to-cart-button.button-secondary {
    text-transform: var(--button-text-case-secondary);
  }

  .product-form-buttons .shopify-payment-button__button {
    width: 100%;
    min-height: var(--minimum-touch-target);
  }

  .quantity-selector,
  .add-to-cart-button {
    height: var(--height-buy-buttons);
  }

  .product__pickup-availabilities {
    width: 100%;
  }

  .pickup-availability__column {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .pickup-availability__row {
    display: flex;
    gap: var(--padding-xs);
  }

  .pickup-availability__dialog-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .pickup-availability__header-container {
    padding-block-end: var(--padding-2xl);
  }

  .pickup-location__wrapper {
    display: flex;
    flex-direction: column;
    padding-block: var(--padding-2xl);
    border-top: 1px solid var(--color-border);
    gap: var(--padding-xs);
  }

  .pickup-location__address-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--padding-md);
  }

  .pickup-location__dialog {
    padding: var(--padding-2xl);
    position: fixed;
    border-radius: 0;
    width: var(--sidebar-width);
    max-width: 95vw;
    height: 100%;
    margin: 0 0 0 auto;
    border: var(--style-border-drawer);
    box-shadow: var(--shadow-drawer);
    background-color: var(--color-background);
  }

  .pickup-location__dialog:modal {
    max-height: 100dvh;
  }

  .pickup-location__text-sm {
    font-size: var(--font-size--sm);
    margin: 0;
  }

  .pickup-location__text-xs {
    font-size: var(--font-size--xs);
    margin: 0;
  }

  .product-form-text__error {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-xs);
  }

  .pickup-location__button {
    width: fit-content;
    color: var(--color-primary);
    font-size: var(--font-size--xs);
    font-family: var(--font-body--family);
    padding: 0;
    cursor: pointer;
    margin-block: var(--margin-xs);
  }

  .pickup-location__button:hover {
    color: var(--color-primary-hover);
  }

  .pickup-location__h4 {
    margin: 0;
  }

  .pickup-location__text-bold {
    font-size: var(--font-size--md);
    font-weight: 600;
    margin: 0;
  }

  .pickup-location__availability-wrapper {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    font-family: var(--font-paragraph--family);
  }

  .pickup-location__address {
    font-style: normal;
  }

  .pickup-location__close-button {
    top: calc(var(--padding-2xl) - (var(--icon-size-xs) / 2));
    right: calc(var(--padding-2xl) - var(--icon-size-xs));
  }
{% endstylesheet %}

{%- if mug_bis_show -%}
  <script>
    /* Tillbaka i lager (kontrakt: preorder.md §7–8). Delegering på document
       så lyssnarna överlever temats sektionsomrendering vid variantbyte. */
    if (!window.mugBisInit) {
      window.mugBisInit = true;
      document.addEventListener('click', function (e) {
        var open = e.target.closest('.mug-bis__open');
        if (open) {
          open.closest('.mug-bis').querySelector('.mug-bis__dialog').showModal();
          return;
        }
        var close = e.target.closest('.mug-bis__close');
        if (close) close.closest('.mug-bis__dialog').close();
      });
      document.addEventListener('submit', function (e) {
        var form = e.target.closest('.mug-bis__form');
        if (!form) return;
        e.preventDefault();
        var root = form.closest('.mug-bis');
        var status = form.querySelector('.mug-bis__status');
        var email = form.querySelector('.mug-bis__email');
        if (!email.checkValidity()) {
          status.textContent = 'Kontrollera e-postadressen.';
          return;
        }
        var submit = form.querySelector('.mug-bis__submit');
        submit.disabled = true;
        status.textContent = '';
        fetch(root.dataset.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: email.value.trim(),
            variant_gid: root.dataset.variantGid,
            product_gid: root.dataset.productGid,
            sku: root.dataset.sku,
            product_title: root.dataset.productTitle,
            variant_title: root.dataset.variantTitle,
            honeypot: form.querySelector('[name="honeypot"]').value
          })
        }).then(function (r) {
          if (r.ok) {
            /* Servern svarar ok:true även för dubbletter/undantag — medvetet,
               samma bekräftelse oavsett så rutten inte läcker vilka adresser
               butiken har. */
            root.classList.add('mug-bis--done');
            status.textContent = 'Tack! Vi mejlar dig när varan finns i lager.';
          } else if (r.status === 400) {
            status.textContent = 'Kontrollera e-postadressen.';
          } else if (r.status === 429) {
            status.textContent = 'Försök igen om en stund.';
          } else {
            status.textContent = 'Något gick fel, försök igen.';
          }
        }).catch(function () {
          status.textContent = 'Något gick fel, försök igen.';
        }).finally(function () {
          submit.disabled = false;
        });
      });
    }
  </script>
{%- endif -%}

