{%- comment -%}
  Produktkarusellens rubrik: ett textfält som visas som rubrik och länkar till
  karusellens valda kollektion (Olle 2026-10-24). Förut ett fritt textblock med
  typsnitt, bredd och utfyllnad — de valen behövdes inte och gav olika rubriker.
  Äldre värden var formaterad text ("<h2>…</h2>"), därför strip_html.
{%- endcomment -%}
{%- liquid
  assign title = block.settings.text | strip_html | strip
  if title == blank
    assign title = closest.collection.title | default: 'content.featured_products'
  endif
  assign url = closest.collection.url
-%}
<h2 class="product-list-title" {{ block.shopify_attributes }}>
  {%- if url != blank -%}
    <a href="{{ url }}" class="product-list-title__link">{{ title | escape }}</a>
  {%- else -%}
    {{- title | escape -}}
  {%- endif -%}
</h2>

{% schema %}
{
  "name": "t:names.collection_title",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Rubrik",
      "info": "Visas som rubrik och länkar till karusellens kollektion. Tomt = kollektionens namn."
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_title",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
