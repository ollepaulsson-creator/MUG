{%- comment -%}
  Skriver ut streckkoden om den är ett giltigt GTIN, annars ingenting.

  Google avvisar ett gtin som inte är rena siffror i längd 8/12/13/14 med
  korrekt kontrollsiffra. Butikens streckkodsfält innehåller ibland
  artikelnummer (99-TC-SWIFT-EQ, 777-Levin330) och ibland koder med trasig
  kontrollsiffra (06471780). En vakt som bara mätte längden släppte igenom
  dem, och Search Console rapporterade Ogiltigt GTIN på 230 produkter.

  Parameter: code (variant.barcode).
{%- endcomment -%}
{%- liquid
  assign code = code | strip
  assign len = code.size
  assign rest = code | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'

  assign numeric = false
  if code != blank and rest == blank
    if len == 8 or len == 12 or len == 13 or len == 14
      assign numeric = true
    endif
  endif

  if numeric
    comment
      Kontrollsiffran: vikta kroppens siffror 3, 1, 3, 1 … räknat från den
      siffra som står närmast kontrollsiffran, och kontrollsiffran ska fylla
      summan upp till närmaste tiotal.
    endcomment
    assign chars = code | split: ''
    assign body_len = len | minus: 1
    assign sum = 0
    for i in (1..body_len)
      assign idx = body_len | minus: i
      assign digit = chars[idx] | times: 1
      assign rest_of_two = i | modulo: 2
      if rest_of_two == 1
        assign digit = digit | times: 3
      endif
      assign sum = sum | plus: digit
    endfor
    assign remainder = sum | modulo: 10
    assign expected = 10 | minus: remainder | modulo: 10
    assign actual = chars[body_len] | times: 1
    if expected == actual
      echo code
    endif
  endif
-%}
