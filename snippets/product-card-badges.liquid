
{%- doc -%}
  Renders product badges for the product card.

  @param {object} product - The product object.
  @param {object} settings - The theme settings object.

  @example
  {% render 'product-card-badges', product: product, settings: settings %}
{%- enddoc -%}

{%- comment %} ── Nyheter: keep tag-based logic intact ── {%- endcomment -%}
{%- assign is_nyhet = false -%}
{%- assign now_seconds = 'now' | date: '%s' | plus: 0 -%}
{%- assign published_seconds = product.published_at | date: '%s' | plus: 0 -%}
{%- assign age_days = now_seconds | minus: published_seconds | divided_by: 86400 -%}
{%- for tag in product.tags -%}
  {%- if tag contains 'Nyheter:' or tag == 'nyhet' or tag == 'new' or tag == 'new-in' -%}
    {%- if age_days <= 60 -%}
      {%- assign is_nyhet = true -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- comment %} ── Förhandsbeställning (fryst kontrakt: preorder.md) — trumfar övriga badgar ── {%- endcomment -%}
{%- assign mug_pre = product.metafields.mug.preorder.value -%}
{%- assign mug_is_preorder = false -%}
{%- if mug_pre -%}
  {%- if mug_pre.ends_at != blank -%}
    {%- assign mug_pre_end = mug_pre.ends_at | date: '%s' | plus: 0 -%}
    {%- if now_seconds <= mug_pre_end -%}
      {%- assign mug_is_preorder = true -%}
    {%- endif -%}
  {%- else -%}
    {%- assign mug_is_preorder = true -%}
  {%- endif -%}
{%- endif -%}

{%- comment %} ── Status: read from metafield, support list and single-value types ── {%- endcomment -%}
{%- assign status_meta = product.metafields.custom.status -%}
{%- assign status_list = '' -%}
{%- if status_meta != blank -%}
  {%- if status_meta.type contains 'list' -%}
    {%- assign status_list = status_meta.value -%}
  {%- else -%}
    {%- assign status_list = status_meta.value | split: ',' -%}
  {%- endif -%}
{%- endif -%}
{%- assign has_status = false -%}
{%- if status_list != blank -%}
  {%- assign has_status = true -%}
{%- endif -%}

{%- comment %} ── Kampanjbadge: kampanjmotorn i Bakhuvudet skriver
  shop.metafields.mug.campaign (json) + product.metafields.mug.campaign
  (= kampanj-id) per swappad produkt. Fryst kontrakt: spec §6.1 steg 6.
  Datumfönstret behålls som hängslen. ── {%- endcomment -%}
{%- assign is_campaign = false -%}
{%- assign campaign_badge_label = 'Kampanj' -%}

{%- assign mug_shop_campaign = shop.metafields.mug.campaign.value -%}
{%- if mug_shop_campaign and mug_shop_campaign.active -%}
  {%- if product.metafields.mug.campaign.value == mug_shop_campaign.id -%}
    {%- assign mf_start = mug_shop_campaign.starts_at | date: '%s' | plus: 0 -%}
    {%- assign mf_end = mug_shop_campaign.ends_at | date: '%s' | plus: 0 -%}
    {%- if now_seconds >= mf_start and now_seconds <= mf_end -%}
      {%- assign is_campaign = true -%}
      {%- assign campaign_badge_label = mug_shop_campaign.badge_text -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

<div
  class="product-badges product-badges--{{ settings.badge_position }}"
  style="
    --badge-border-radius: {{ settings.badge_corner_radius }}px;
    --badge-font-family: var(--font-{{ settings.badge_font_family }}--family);
    --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight);
    --badge-text-transform: {{ settings.badge_text_transform }};
  "
>
  {%- comment %} ── One badge at a time, in priority order ── {%- endcomment -%}
  {%- if mug_is_preorder -%}
    <div class="product-badges__badge product-badges__badge--rectangle color-scheme-preorder">
      <span class="product-badges__badge-text">Förhandsbeställning</span>
    </div>
  {%- elsif status_list contains 'Begagnad' -%}
    <div class="product-badges__badge product-badges__badge--rectangle color-scheme-status color-scheme-status--begagnad">
      <span class="product-badges__badge-text">Begagnad</span>
    </div>
  {%- elsif status_list contains 'B-stock' -%}
    <div class="product-badges__badge product-badges__badge--rectangle color-scheme-status color-scheme-status--b-stock">
      <span class="product-badges__badge-text">B-stock</span>
    </div>
  {%- elsif is_campaign -%}
    <div class="product-badges__badge product-badges__badge--rectangle color-{{ settings.badge_sale_color_scheme }} color-scheme-sale">
      <span class="product-badges__badge-text">{{ campaign_badge_label }}</span>
    </div>
  {%- elsif is_nyhet -%}
    <div class="product-badges__badge product-badges__badge--rectangle color-scheme-nyhet">
      <span class="product-badges__badge-text">Nyhet</span>
    </div>
  {%- elsif product.available == false -%}
    <div class="product-badges__badge product-badges__badge--rectangle color-{{ settings.badge_sold_out_color_scheme }} color-scheme-soldout">
      <span class="product-badges__badge-text">{{ 'content.product_badge_sold_out' | t }}</span>
    </div>
  {%- elsif product.compare_at_price > product.price and product.available -%}
    <div class="product-badges__badge product-badges__badge--rectangle color-{{ settings.badge_sale_color_scheme }} color-scheme-sale">
      <span class="product-badges__badge-text">{{ 'content.product_badge_sale' | t }}</span>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .product-badges {
    --badge-inset: max(var(--padding-xs), calc((var(--border-radius) + var(--padding-xs)) * (1 - cos(45deg))));
    position: absolute;
    z-index: var(--layer-flat);
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 4px;
  }

  .product-badges--bottom-left {
    bottom: calc(var(--badge-inset) + var(--padding-block-start));
    left: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-left {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    left: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-right {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    right: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges__badge {
    --badge-font-size: var(--font-size--xs);
    --badge-bg: var(--color-background);
    /* Bakgrunden målas per textrad av .product-badges__badge-text
       (box-decoration-break: clone) — långa labels får en tajt box per rad
       i stället för en bred platta. Själva badgen är därför genomskinlig. */
    display: block;
    text-align: left;
    color: var(--color-foreground);
    background: none;
    font-size: var(--badge-font-size);
    font-family: var(--badge-font-family);
    font-weight: var(--badge-font-weight);
    text-transform: var(--badge-text-transform);
    border-radius: 0px;
    letter-spacing: 0.08rem !important;
  }

  .product-badges__badge--rectangle {
    text-transform: uppercase;
  }

  .product-badges__badge-text {
    display: inline;
    background: var(--badge-bg);
    padding: 0.45em 0.75em 0.4em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    line-height: 2;
  }

  /* Status metafield badges (default) */
  .product-badges__badge.color-scheme-status {
    --badge-bg: #fff;
    color: #000;
    font-size: 12px!important;
    letter-spacing: 1px;
  }

  /* B-stock status override */
  .product-badges__badge.color-scheme-status--b-stock {
    color: #e70a0a;
  }

  /* Rea/Sale badge */
  .product-badges__badge.color-scheme-sale {
    --badge-bg: #fff;
    color: #e70a0a;
    font-size: 12px!important;
    letter-spacing: 1px;
  }

  /* Nyhet badge */
  .product-badges__badge.color-scheme-nyhet {
    --badge-bg: #fff;
    color: #000;
    font-size: 12px!important;
    letter-spacing: 1px;
  }

  /* Förhandsbeställning badge — samma vita platta som Nyhet */
  .product-badges__badge.color-scheme-preorder {
    --badge-bg: #fff;
    color: #000;
    font-size: 12px!important;
    letter-spacing: 1px;
  }

  /* Slutsåld badge — vit platta som övriga, i stället för schemats grå */
  .product-badges__badge.color-scheme-soldout {
    --badge-bg: #fff;
    color: #000;
    font-size: 12px!important;
    letter-spacing: 1px;
  }
{% endstylesheet %}
